<section id="sonarMonitor" style="margin:14px;padding:20px;border:1px solid #354450;border-radius:12px;background:#151c23;color:#e6edf3"><h2>超声波近距离监测</h2><p style="color:#a6b4c2">已接入导航和手柄的前进／侧移／转弯停车保护：车身间距≤20cm停车，≥28cm解除；倒车依赖激光雷达。前方车头轴向间距已扣除探头后缩 8 cm；请核对地面及车架回波。</p><p id="sonarStopLive"></p><div id="devSonarRows" role="status">正在读取…</div></section>
<script>
(()=>{const root=document.getElementById('devSonarRows');let busy=false;async function update(){if(busy||document.hidden)return;busy=true;const ctl=new AbortController(),timer=setTimeout(()=>ctl.abort(),3000);try{const r=await fetch('/api/sonar/status',{signal:ctl.signal,cache:'no-store'});if(!r.ok)throw Error();const d=await r.json();const stop=d.stop_protection;document.getElementById('sonarStopLive').textContent=stop&&Date.now()/1000-stop.updated_at<2?'实际保护：'+(stop.reasons.join('；')||'最近速度指令未触发超声波限制'):'实际保护：当前无新速度处理记录，请结合底盘运行状态判断';root.replaceChildren();if(d.stale){root.textContent='数据离线或过期，无法判断障碍';return}for(const c of d.channels){const row=document.createElement('div');row.style.cssText='padding:10px 0;border-bottom:1px solid #354450';row.textContent=c.name+' ['+c.pins.join('/')+']：'+(c.stale?'数据过期':c.distance_m==null?'无有效回波，状态未知':(c.distance_m*100).toFixed(1)+' cm；车身轴向间距 '+(c.clearance_along_axis_m*100).toFixed(1)+' cm；'+c.hint)+' · 数据年龄 '+c.age_s+' s';root.append(row)}const note=document.createElement('p');note.textContent='保护算法试算（未启用）：有效原始距离 >80 cm 不触发，≤80 cm 参与限速；无回波或过期不算畅通。假定响应时间 0.8 秒、减速度 0.35 m/s²、余量 10 cm，需实测后调整。';root.append(note);for(const p of d.protection_preview||[]){const row=document.createElement('div'),names={forward:'前进 0.4 m/s',left:'左移 0.15 m/s',right:'右移 0.15 m/s',reverse:'倒车',rotate:'原地旋转'},states={stop:'建议停止',slow:'建议减速',no_limit:'本次不建议限速（不代表安全）',uncovered:'覆盖不足'};row.textContent=names[p.direction]+'：'+states[p.state]+(p.cap_mps==null?'':' · 试算上限 '+p.cap_mps+' m/s')+'；'+p.reason;row.style.padding='6px 0';root.append(row)}}catch(e){root.textContent='连接中断，超声波状态未知'}finally{clearTimeout(timer);busy=false}}setInterval(update,1000);document.addEventListener('visibilitychange',update);update()})();
</script>