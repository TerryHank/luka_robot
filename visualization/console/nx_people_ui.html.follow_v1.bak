<section id="nxPeople" aria-labelledby="nxPeopleTitle">
  <style>
    #nxPeople{margin:14px;padding:20px;border:1px solid #354450;border-radius:12px;background:#151c23;color:#e6edf3;font:15px/1.6 system-ui,sans-serif}
    #nxPeople *{box-sizing:border-box}#nxPeople h2{font-size:23px;margin:0}#nxPeople h3{font-size:16px;margin:0 0 10px}
    #nxPeople p{margin:8px 0}#nxPeople .np-muted{color:#a5b5c4}#nxPeople .np-head,#nxPeople .np-actions,#nxPeople .np-profile{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
    #nxPeople .np-head{justify-content:space-between}#nxPeople .np-badge{padding:3px 11px;border-radius:20px;background:#263442;color:#c8d7e5}
    #nxPeople .np-badge[data-ready="true"]{background:#193d34;color:#91dfc1}#nxPeople .np-note{padding:10px 12px;background:#262c25;border-left:3px solid #baaa70;color:#dcd7b8}
    #nxPeople .np-grid{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(270px,1fr);gap:18px;margin-top:16px}
    #nxPeople .np-camera{position:relative;aspect-ratio:4/3;overflow:hidden;border:1px solid #354450;border-radius:9px;background:#0b1117}
    #nxPeople canvas{display:block;width:100%;height:100%;cursor:crosshair}#nxPeople .np-mask{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:20px;background:#0b1117df;color:#c7d5e2;pointer-events:none}
    #nxPeople .np-mask[hidden],#nxPeople [hidden]{display:none!important}#nxPeople .np-card{padding:14px;border:1px solid #354450;border-radius:9px;margin-bottom:12px;background:#111920}
    #nxPeople button{width:auto;margin:0;padding:8px 13px;border:1px solid #4d6478;border-radius:7px;background:#263847;color:#e6edf3;font:inherit;cursor:pointer}
    #nxPeople button:hover:not(:disabled){background:#324c60}#nxPeople button:focus-visible,#nxPeople input:focus-visible,#nxPeople select:focus-visible{outline:2px solid #80d3b7;outline-offset:2px}
    #nxPeople button.np-primary{background:#245b4a;border-color:#418d75}#nxPeople button.np-danger{background:#4a2930;border-color:#7a414b}#nxPeople button:disabled{opacity:.42;cursor:not-allowed}
    #nxPeople input,#nxPeople select{width:100%;padding:10px;margin:5px 0 10px;border:1px solid #4d6478;border-radius:7px;background:#0c141c;color:#e6edf3;font:inherit}
    #nxPeople .np-tracks{display:grid;align-content:start;gap:8px;margin-top:10px;height:184px;overflow-y:auto;overscroll-behavior:contain}#nxPeople .np-track{text-align:left;width:100%}#nxPeople .np-track[aria-pressed="true"]{border-color:#80d3b7;background:#183f35}
    #nxPeopleState{flex-basis:100%;height:3.2em;overflow-y:auto}#nxPeopleTarget{height:3.2em;overflow-y:auto}#nxPeopleSession{height:6.4em;overflow-y:auto}#nxPeople .np-target-details{height:96px;overflow-y:auto}
    #nxPeople .np-track span{display:block}#nxPeople .np-profile{padding:8px 0;border-bottom:1px solid #2a3845}#nxPeople .np-profile span{flex:1;overflow-wrap:anywhere}#nxPeople .np-profile button{font-size:13px;padding:4px 10px}
    #nxPeople .np-link{display:block;margin-top:3px;color:#91dfc1}
    #nxPeople .np-message{min-height:24px;color:#e4c482;overflow-wrap:anywhere}#nxPeople .np-stats{font-size:13px;color:#9aafc1;margin-top:7px}#nxPeople .np-detail{font-size:13px;white-space:pre-line;color:#bdcdd9}#nxPeople progress{width:100%;height:9px;accent-color:#80d3b7}
    @media(max-width:820px){#nxPeople{margin:10px;padding:14px}#nxPeople .np-grid{grid-template-columns:1fr}}
  </style>
  <div class="np-head"><h2 id="nxPeopleTitle">人体与身份识别</h2><span id="nxPeopleBadge" class="np-badge">正在连接</span></div>
  <p><strong>静态目标锁定，不控制车轮</strong></p>
  <p class="np-note">相机仍在离地约 20 cm、水平朝前的位置，正常站立时可能拍不到人脸。可直接选择人体，再手动确认本次目标；不必每次贴近镜头。人脸识别结果与本次目标身份分开显示。</p>
  <div class="np-actions">
    <button id="nxPeopleStart" class="np-primary" type="button" disabled>启动静态识别</button>
    <button id="nxPeopleStop" type="button" disabled>停止识别</button>
    <span id="nxPeopleState" class="np-muted" role="status">正在读取状态…</span>
  </div>
  <div class="np-grid">
    <div>
      <div class="np-camera">
        <canvas id="nxPeopleCanvas" width="640" height="480" role="img" aria-label="人体识别画面；可使用下方人体列表选择目标"></canvas>
        <div id="nxPeopleMask" class="np-mask">尚未收到识别画面</div>
      </div>
      <div id="nxPeopleStats" class="np-stats">等待相机数据</div>
      <div id="nxPeopleMemory" class="np-stats">等待系统内存数据</div>
      <p class="np-muted">点击人体框或下方列表选择观察目标，无需先识别人脸。目前仅验证目标锁定，不会启动跟随。</p>
      <div id="nxPeopleTracks" class="np-tracks"><span class="np-muted">尚未发现人体</span></div>
    </div>
    <div>
      <div class="np-card">
        <h3>当前观察目标</h3>
        <p id="nxPeopleTarget">未选择</p>
        <div class="np-target-details"><p id="nxPeopleTargetDetails" class="np-detail" hidden></p></div>
        <button id="nxPeopleUnlock" type="button" disabled>解除目标锁定</button>
        <p class="np-muted">追踪编号只区分当前画面中的目标，不能作为人员身份。</p>
      </div>
      <div class="np-card">
        <h3>本次目标确认</h3>
        <p id="nxPeopleSession" role="status">先在画面中选择人体。</p>
        <label for="nxPeopleTargetProfile">选中的人是</label>
        <select id="nxPeopleTargetProfile"><option value="">请选择已登记人员</option></select>
        <button id="nxPeopleConfirmTarget" class="np-primary" type="button" disabled>确认身份并锁定</button>
        <p class="np-muted">由你确认本次目标，不修改人脸档案。短暂漏检或遮挡时先等待并核对原目标；持续丢失或无法分清多人时需重新选择。确认后，连续追踪同一个人体时无需持续看到正脸。</p>
      </div>
      <div class="np-card">
        <h3>本机人脸登记</h3>
        <form id="nxPeopleEnrollForm">
          <label for="nxPeopleName">姓名或称呼</label>
          <input id="nxPeopleName" type="text" maxlength="32" placeholder="例如：瞿哥" autocomplete="off">
          <div class="np-actions">
            <button id="nxPeopleEnroll" class="np-primary" type="submit" disabled>为选中目标登记人脸</button>
            <button id="nxPeopleSupplement" type="button" disabled>为已登记本人补录侧脸</button>
            <button id="nxPeopleFinishEnroll" type="button" disabled>完成录入</button>
            <button id="nxPeopleCancelEnroll" type="button" disabled>取消登记</button>
          </div>
        </form>
        <p class="np-muted">首次登记填写称呼。补录侧脸需先让已登记本人通过人脸确认，再点选人体并点击补录；缓慢左右转头，原档案和声纹关联会保留。仅在主动点击后采集并保存在本机，请先征得本人同意。</p>
        <div id="nxPeopleEnrollment" hidden>
          <p id="nxPeopleEnrollState" role="status"></p>
          <p id="nxPeopleEnrollPrompt" role="status" class="np-callout"></p>
          <progress id="nxPeopleEnrollProgress" max="1" value="0" aria-label="人脸登记进度"></progress>
        </div>
      </div>
      <div class="np-card">
        <h3>已登记身份</h3>
        <div id="nxPeopleProfiles"><span class="np-muted">正在读取…</span></div>
        <div id="nxPeopleDeleteConfirm" hidden>
          <p id="nxPeopleDeleteText"></p>
          <div class="np-actions"><button id="nxPeopleDeleteYes" class="np-danger" type="button">确认删除</button><button id="nxPeopleDeleteNo" type="button">保留</button></div>
        </div>
      </div>
    </div>
  </div>
  <p id="nxPeopleMessage" class="np-message" role="status" aria-live="polite"></p>
</section>
