"""Select an enrolled face or a clicked live body before enabling follow.

No camera frames or biometric vectors leave the robot. This component only
orchestrates identity/body selection; nx_follow is the motion safety gate.
"""
import json
import math
import threading
import time
import urllib.error
import urllib.request


BASE = 'http://127.0.0.1:8098/api/people/'


def people_request(path, body=None):
    data = None if body is None else json.dumps(body).encode('utf-8')
    req = urllib.request.Request(BASE + path, data=data,
                                 headers={'Content-Type': 'application/json'})
    try:
        with urllib.request.urlopen(req, timeout=1.5) as response:
            return json.load(response)
    except urllib.error.HTTPError as exc:
        try:
            message = json.load(exc).get('error', '人体识别服务拒绝请求')
        except (ValueError, OSError):
            message = '人体识别服务拒绝请求'
        raise ValueError(message) from exc


def live_track(state, track_id):
    age = state.get('camera_age')
    if (state.get('active') is not True or state.get('loading') or state.get('error')
            or not isinstance(age, (int, float)) or not math.isfinite(age)
            or age < 0 or age > .7):
        return None
    rows = [row for row in state.get('tracks') or []
            if row.get('track_id') == track_id and row.get('visible') is True
            and not row.get('association_ambiguous')
            and row.get('observation_strength') in ('strong', 'strong_detection')]
    return rows[0] if len(rows) == 1 else None


def matched_profile(state, profile_id):
    matches = []
    for row in state.get('tracks') or []:
        identity = row.get('identity') or {}
        if (identity.get('state') == 'matched' and identity.get('id') == profile_id
                and live_track(state, row.get('track_id')) is row):
            matches.append(row)
    return matches[0] if len(matches) == 1 else None


class FollowAcquisition:
    def __init__(self, controller, request=people_request,
                 clock=time.monotonic, sleep=time.sleep):
        self.controller, self.request = controller, request
        self.clock, self.sleep = clock, sleep
        self.lock = threading.Lock()
        self.generation = 0
        self.phase = 'idle'
        self.message = '请选择已登记人员或当前画面人体'
        self.mode = None

    def status(self):
        with self.lock:
            phase, message, mode = self.phase, self.message, self.mode
        if phase == 'following' and not getattr(self.controller, 'enabled', True):
            phase, message, mode = 'idle', self.controller.reason, None
        return {'phase': phase, 'message': message, 'mode': mode}

    def _update(self, generation, phase, message):
        with self.lock:
            if generation == self.generation:
                self.phase, self.message = phase, message

    def _current(self, generation, epoch):
        with self.lock:
            return generation == self.generation and epoch == self.controller.command_epoch

    def cancel(self):
        with self.lock:
            self.generation += 1
            self.phase, self.message, self.mode = 'idle', '已停车', None

    def choose(self, mode, identifier):
        if mode not in ('profile', 'track'):
            raise ValueError('请选择已登记人员或当前画面人体')
        if mode == 'profile':
            if not isinstance(identifier, str) or not identifier or len(identifier) > 80:
                raise ValueError('请选择已登记人员')
            catalog = self.request('status')
            if identifier not in {p.get('id') for p in catalog.get('profiles') or []}:
                raise ValueError('该人员尚未登记')
        else:
            if type(identifier) is not int or identifier < 0:
                raise ValueError('请先点击画面中的人体框')
            state = self.request('follow-state')
            if state.get('selected_track_id') != identifier or not live_track(state, identifier):
                raise ValueError('所选人体已过期或不稳定，请重新点选')
        self.controller.stop('正在选择新跟随目标')
        with self.lock:
            self.generation += 1
            generation = self.generation
            epoch = self.controller.command_epoch
            self.mode = mode
            self.phase = 'acquiring'
            self.message = '正在人脸核对…' if mode == 'profile' else '正在确认当前人体…'
        threading.Thread(target=self._run, args=(generation, epoch, mode, identifier),
                         daemon=True).start()
        return self.status()

    def _run(self, generation, epoch, mode, identifier):
        try:
            deadline = self.clock() + (20 if mode == 'profile' else 5)
            last_frame, candidate, streak = None, None, 0
            while self.clock() < deadline and self._current(generation, epoch):
                state = self.request('follow-state')
                if mode == 'track' and state.get('selected_track_id') != identifier:
                    raise ValueError('所选人体已改变，请重新点选')
                row = matched_profile(state, identifier) if mode == 'profile' else live_track(state, identifier)
                frame = state.get('frame_at')
                if frame != last_frame:
                    key = row.get('track_id') if row else None
                    streak = streak + 1 if key is not None and key == candidate else 1 if key is not None else 0
                    candidate = key
                    last_frame = frame
                    if streak >= 2:
                        break
                self.sleep(.2)
            else:
                if self._current(generation, epoch):
                    raise ValueError('没有持续看到所选人员，请让其进入相机画面并重新尝试')
                return
            track_id = candidate
            if not self._current(generation, epoch):
                return
            if mode == 'profile':
                self.request('select', {'track_id': track_id})
            self._update(generation, 'waiting_range', '已锁定目标，正在等待双目距离和雷达通道稳定…')
            deadline = self.clock() + 8
            last_error = '双目距离或雷达尚未就绪'
            while self.clock() < deadline and self._current(generation, epoch):
                try:
                    result = self.controller.start(mode=mode, expected_track_id=track_id,
                                                   expected_profile_id=identifier if mode == 'profile' else None,
                                                   expected_epoch=epoch)
                    if result.get('enabled'):
                        self._update(generation, 'following', '正在跟随；目标或障碍不确定时会停车')
                        return
                except ValueError as exc:
                    last_error = str(exc)
                    if any(word in last_error for word in ('导航、巡航', '底盘跟随开关未就绪',
                                                          '所选人体已经变化', '已被停车')):
                        raise
                self.sleep(.25)
            if self._current(generation, epoch):
                raise ValueError('已选择目标，但未启动车轮：' + last_error)
        except Exception as exc:
            self._update(generation, 'blocked', str(exc)[:140])
