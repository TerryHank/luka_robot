    def on_motion_mode(self, msg: String) -> None:
        mode = normalize_motion_mode(msg.data)
        if mode == self.motion_mode:
            return
        self.motion_mode = mode
        self.enter_state("pass")
        self.publish_zero()
        self.last_status = ""
        self.get_logger().info(f"navigation motion mode changed to {mode}")

    def publish_nav_command(
        self,
        source: Twist,
        front: Optional[float] = None,
        left: Optional[float] = None,
        right: Optional[float] = None,
    ) -> None:
        if self.motion_mode != "forward_facing":
            self.cmd_pub.publish(source)
            return
        if abs(source.linear.x) + abs(source.linear.y) + abs(source.angular.z) < 1e-6:
            self.publish_zero()
            return
        self.path_allows_escape()  # Refresh distance using the latest path/TF.
        if self.path_active and self.goal_distance is not None and self.goal_distance <= 0.5:
            # Preserve the collision-checked terminal command, including its
            # requested sign. Do not add a second heading controller here.
            self.heading_error_deg = 0.0
            self.publish_smoothed(float(source.linear.x), float(source.linear.y),
                                  clamp(float(source.angular.z), -0.45, 0.45))
            return
        lateral_ratio, lateral_max = adaptive_lateral_authority(
            front,
            trigger_distance=self.front_trigger_distance,
            release_distance=self.heading_obstacle_release_distance,
            normal_ratio=self.heading_normal_lateral_ratio,
            obstacle_ratio=self.heading_obstacle_lateral_ratio,
            normal_max=self.heading_normal_lateral_max,
            obstacle_max=self.heading_obstacle_lateral_max,
        )
        if self.in_narrow_passage(left, right):
            lateral_ratio = self.heading_normal_lateral_ratio
            lateral_max = self.heading_normal_lateral_max
        vx, vy, wz = forward_facing_velocity(
            float(source.linear.x),
            float(source.linear.y),
            float(source.angular.z),
            heading_kp=self.heading_align_kp,
            max_wz=self.heading_align_max_wz,
            lateral_ratio=lateral_ratio,
            lateral_max=lateral_max,
        )
        self.heading_error_deg = math.degrees(
            math.atan2(float(source.linear.y), float(source.linear.x))
        ) if math.hypot(float(source.linear.x), float(source.linear.y)) > 1e-6 else 0.0
        self.lateral_authority = lateral_ratio
        self.publish_smoothed(vx, vy, wz)

    def publish_smoothed(self, vx: float, vy: float, wz: float) -> None:
        now = time.monotonic()
        dt = clamp(now - self.last_nav_output_time, 0.01, 0.12)

        def approach(current: float, target: float, rate: float) -> float:
            delta = clamp(target - current, -rate * dt, rate * dt)
            return current + delta

        previous_vx, previous_vy, previous_wz = self.last_nav_output
        output = (
            approach(previous_vx, vx, self.heading_linear_accel_limit),
            approach(previous_vy, vy, self.heading_lateral_accel_limit),
            approach(previous_wz, wz, self.heading_angular_accel_limit),
        )
        self.last_nav_output = output
        self.last_nav_output_time = now
        command = Twist()
        command.linear.x, command.linear.y, command.angular.z = output
        self.cmd_pub.publish(command)

    def on_cmd(self, msg: Twist) -> None:
        self.latest_cmd = msg
        self.latest_cmd_time = time.monotonic()
        if (
            abs(msg.linear.x) > 0.01
            or abs(msg.linear.y) > 0.01
            or abs(msg.angular.z) > 0.01
        ):
            self.last_motion_cmd_time = self.latest_cmd_time
        # With timed escape disabled, Omni is a direct pass-through. Forward-facing
        # mode still uses laser clearance to gradually release Nav2's requested
        # lateral velocity near a frontal obstacle; it never invents a side-step.
        if not self.active_escape_enabled:
            if self.motion_mode == "forward_facing":
                front, left, right, _, _ = self.clearances()
                self.publish_nav_command(msg, front, left, right)
            else:
                self.publish_nav_command(msg)
            return
        if self.state == "pass":
            front, left, right, laser_front, camera_front = self.clearances()
            if self.should_escape(front, msg):
                if self.in_narrow_passage(left, right):
                    if front is not None and front < self.narrow_passage_front_stop_distance:
                        self.enter_state("hold_stop")
                        self.publish_zero()
                    else:
                        self.publish_nav_command(msg, front, left, right)
                    self.publish_status(front, left, right, laser_front, camera_front)
                    return
                if self.path_allows_escape():
                    self.start_escape(left, right)
                else:
                    self.enter_state("hold_stop")
                    self.publish_zero()
                self.publish_status(front, left, right, laser_front, camera_front)
                return
            self.publish_nav_command(msg, front, left, right)

    def on_scan(self, msg: LaserScan) -> None:
        if not self.active_escape_enabled and self.motion_mode != "forward_facing":
            return
        self.latest_scan = msg
        self.latest_scan_clearances = self.calculate_scan_clearances(msg)

    def on_plan(self, msg: Path) -> None:
        if not self.active_escape_enabled and self.motion_mode != "forward_facing":
            return
        self.latest_plan = msg
        self.latest_plan_time = time.monotonic()

    def on_camera_info(self, msg: CameraInfo) -> None:
        if msg.k[0] > 0.0 and msg.k[4] > 0.0:
            self.camera_intrinsics = (msg.k[0], msg.k[4], msg.k[2], msg.k[5])

    def on_depth_distance(self, msg: Float32) -> None:
        if not self.active_escape_enabled:
            return
        now = time.monotonic()
        candidate = float(msg.data)
        if math.isfinite(candidate) and candidate > 0.0:
            self.depth_confirmation_count += 1
            self.last_depth_candidate = candidate
            self.last_camera_detection_time = now
            if self.depth_confirmation_count >= self.camera_confirmation_frames:
                self.latest_camera_front = candidate
        else:
            self.depth_confirmation_count = 0
            self.last_depth_candidate = None
            if now - self.last_camera_detection_time > self.camera_obstacle_persistence:
                self.latest_camera_front = None
        self.latest_camera_time = now

    def on_camera_depth(self, msg: Image) -> None:
        now = time.monotonic()
        if self.state == "pass" and now - self.last_motion_cmd_time > self.camera_motion_hold:
            return
        if now - self.last_camera_processing_time < self.camera_processing_period:
            return
        self.last_camera_processing_time = now
        if self.camera_intrinsics is None:
            return

        try:
            transform = self.tf_buffer.lookup_transform(
                self.base_frame,
                msg.header.frame_id,
                Time(),
                timeout=Duration(seconds=0.03),
            ).transform
        except Exception as exc:
            self.get_logger().debug(f"camera cloud transform unavailable: {exc}")
            return

        q = transform.rotation
        xx = q.x * q.x
        yy = q.y * q.y
        zz = q.z * q.z
        xy = q.x * q.y
        xz = q.x * q.z
        yz = q.y * q.z
        wx = q.w * q.x
        wy = q.w * q.y
        wz = q.w * q.z
        rotation = (
            (1.0 - 2.0 * (yy + zz), 2.0 * (xy - wz), 2.0 * (xz + wy)),
            (2.0 * (xy + wz), 1.0 - 2.0 * (xx + zz), 2.0 * (yz - wx)),
            (2.0 * (xz - wy), 2.0 * (yz + wx), 1.0 - 2.0 * (xx + yy)),
        )

        try:
            endian = ">" if msg.is_bigendian else "<"
            if msg.encoding in ("16UC1", "mono16"):
                dtype = np.dtype(endian + "u2")
                depth_scale = self.camera_depth_scale
            elif msg.encoding == "32FC1":
                dtype = np.dtype(endian + "f4")
                depth_scale = 1.0
            else:
                raise ValueError(f"unsupported depth encoding: {msg.encoding}")

            depth = np.ndarray(
                shape=(msg.height, msg.width),
                dtype=dtype,
                buffer=memoryview(msg.data),
                strides=(msg.step, dtype.itemsize),
            )
            rows = np.arange(0, msg.height, self.camera_pixel_step, dtype=np.float32)
            cols = np.arange(0, msg.width, self.camera_pixel_step, dtype=np.float32)
            sampled = depth[:: self.camera_pixel_step, :: self.camera_pixel_step].astype(
                np.float32, copy=False
            )
            z = sampled.reshape(-1) * depth_scale
            u, v = np.meshgrid(cols, rows)
            valid_depth = np.isfinite(z) & (z > 0.05)
            z = z[valid_depth]
            u = u.reshape(-1)[valid_depth]
            v = v.reshape(-1)[valid_depth]
            fx, fy, cx, cy = self.camera_intrinsics
            source = np.column_stack(
                (
                    (u - cx) * z / fx,
                    (v - cy) * z / fy,
                    z,
                )
            )
            source = source[np.isfinite(source).all(axis=1)]
            if source.size == 0:
                front_values = np.empty(0, dtype=np.float32)
            else:
                base = source @ np.asarray(rotation, dtype=np.float32).T
                base += np.asarray(
                    [
                        transform.translation.x,
                        transform.translation.y,
                        transform.translation.z,
                    ],
                    dtype=np.float32,
                )
                mask = (
                    (base[:, 2] >= self.camera_min_height)
                    & (base[:, 2] <= self.camera_max_height)
                    & (base[:, 0] >= self.camera_min_forward)
                    & (base[:, 0] <= self.camera_max_forward)
                    & (np.abs(base[:, 1]) <= self.camera_front_half_width)
                )
                front_values = base[mask, 0]
        except Exception as exc:
            self.get_logger().debug(f"camera cloud processing failed: {exc}")
            return

        if front_values.size >= self.camera_min_points:
            index = int(0.10 * (front_values.size - 1))
            candidate = float(np.partition(front_values, index)[index])
            self.camera_detection_count += 1
            self.last_camera_detection_time = now
            if self.camera_detection_count >= self.camera_confirmation_frames:
                self.latest_camera_front = candidate
        else:
            self.camera_detection_count = 0
            if now - self.last_camera_detection_time > self.camera_obstacle_persistence:
                self.latest_camera_front = None
        self.latest_camera_time = now

    def on_timer(self) -> None:
        if not self.active_escape_enabled:
            return
        now = time.monotonic()
        front, left, right, laser_front, camera_front = self.clearances()
        cmd_fresh = self.latest_cmd is not None and (
            now - self.latest_cmd_time <= self.cmd_timeout
        )

        if not cmd_fresh:
            if self.state != "pass":
                self.publish_zero()
                self.enter_state("pass")
            self.publish_status(front, left, right, laser_front, camera_front)
            return

        assert self.latest_cmd is not None
        if self.state == "pass":
            if self.should_escape(front, self.latest_cmd):
                if self.in_narrow_passage(left, right):
                    if front is not None and front < self.narrow_passage_front_stop_distance:
                        self.enter_state("hold_stop")
                        self.publish_zero()
                    self.publish_status(front, left, right, laser_front, camera_front)
                    return
                if now - self.last_escape_finished < self.escape_cooldown_duration:
                    self.enter_state("hold_stop")
                    self.publish_zero()
                    self.publish_status(front, left, right, laser_front, camera_front)
                    return
                if self.path_allows_escape():
                    self.start_escape(left, right)
                else:
                    self.enter_state("hold_stop")
                    self.publish_zero()
            self.publish_status(front, left, right, laser_front, camera_front)
            return

        elapsed = now - self.state_started
        if self.state == "hold_stop":
            self.publish_zero()
            if elapsed >= self.hold_stop_duration:
                self.enter_state("pass")
            self.publish_status(front, left, right, laser_front, camera_front)
            return

        if self.state == "escape":
            target_clearance = left if self.escape_side > 0.0 else right
            if (
                target_clearance is None
                or target_clearance < self.escape_side_stop_distance
            ):
                self.last_escape_finished = now
                self.enter_state("hold_stop")
                self.publish_zero()
                self.publish_status(front, left, right, laser_front, camera_front)
                return
            if elapsed >= self.min_escape_duration and self.is_front_clear(front):
                self.last_escape_finished = now
                self.enter_state("pass")
                self.publish_nav_command(self.latest_cmd, front, left, right)
                self.publish_status(front, left, right, laser_front, camera_front)
                return
            if elapsed >= self.max_escape_duration:
                self.last_escape_finished = now
                self.enter_state("hold_stop")
                self.publish_zero()
                self.publish_status(front, left, right, laser_front, camera_front)
                return
            self.publish_escape()
            self.publish_status(front, left, right, laser_front, camera_front)

    def should_escape(self, front: Optional[float], cmd: Twist) -> bool:
        # Normal obstacle avoidance belongs to the holonomic MPPI controller.
        # The old timed side-step is retained only as an explicitly enabled
        # recovery, so it cannot fight the controller or move a fixed distance.
        if not self.active_escape_enabled:
            return False
        if front is None:
            return False
        if cmd.linear.x <= self.min_forward_cmd:
            return False
        if cmd.linear.x < abs(cmd.linear.y) * self.forward_dominance_ratio:
            return False
        if abs(cmd.angular.z) > 0.35:
            return False
        return front < self.front_trigger_distance

    def in_narrow_passage(
        self, left: Optional[float], right: Optional[float]
    ) -> bool:
        return (
            left is not None
            and right is not None
            and left < self.narrow_passage_side_limit
            and right < self.narrow_passage_side_limit
        )

    def path_allows_escape(self) -> bool:
        self.path_active = False
        self.goal_distance = None
        if self.latest_plan is None or not self.latest_plan.poses:
            return False
        if time.monotonic() - self.latest_plan_time > self.path_timeout:
            return False

        frame_id = self.latest_plan.header.frame_id
        if not frame_id:
            frame_id = self.latest_plan.poses[-1].header.frame_id
        if not frame_id:
            return False

        try:
            transform = self.tf_buffer.lookup_transform(
                frame_id,
                self.base_frame,
                Time(),
                timeout=Duration(seconds=0.03),
            ).transform
        except Exception:
            return False

        goal = self.latest_plan.poses[-1].pose.position
        self.goal_distance = math.hypot(
            goal.x - transform.translation.x,
            goal.y - transform.translation.y,
        )
        self.path_active = True
        return self.goal_distance > self.terminal_no_escape_distance

    def is_front_clear(self, front: Optional[float]) -> bool:
        return front is not None and front > self.front_clear_distance

    def start_escape(self, left: Optional[float], right: Optional[float]) -> None:
        left_score = left if left is not None else 0.0
        right_score = right if right is not None else 0.0
        escape_side = choose_escape_side(
            left,
            right,
            self.min_side_clearance,
            self.min_side_advantage,
        )
        if escape_side == 0.0:
            self.enter_state("hold_stop")
            self.publish_zero()
            self.get_logger().warn(
                "front obstacle detected, side choice is ambiguous; stopping "
                f"(left={left_score:.2f}m right={right_score:.2f}m)"
            )
            return

        self.escape_side = escape_side
        self.enter_state("escape")
        self.publish_escape()
        self.get_logger().warn(
            "front obstacle detected, sidestepping "
            f"{'left' if self.escape_side > 0.0 else 'right'} "
            f"(left={left_score:.2f}m right={right_score:.2f}m)"
        )

    def enter_state(self, state: str) -> None:
        self.state = state
        self.state_started = time.monotonic()
        if state == "pass":
            self.escape_side = 0.0

    def publish_escape(self) -> None:
        vx = self.escape_forward_speed
        vy = self.escape_side * self.lateral_direction_sign * self.escape_lateral_speed
        if self.motion_mode == "forward_facing":
            self.lateral_authority = 1.0
            self.publish_smoothed(vx, vy, 0.0)
            return
        cmd = Twist()
        cmd.linear.x = vx
        cmd.linear.y = vy
        self.cmd_pub.publish(cmd)

    def publish_zero(self) -> None:
        self.last_nav_output = (0.0, 0.0, 0.0)
        self.last_nav_output_time = time.monotonic()
        self.cmd_pub.publish(Twist())

    def scan_clearances(self) -> Tuple[Optional[float], Optional[float], Optional[float]]:
        return self.latest_scan_clearances

    def calculate_scan_clearances(
        self, scan: LaserScan
    ) -> Tuple[Optional[float], Optional[float], Optional[float]]:
        geometry = (len(scan.ranges), float(scan.angle_min), float(scan.angle_increment))
        if geometry != self._scan_mask_geometry:
            angles = scan.angle_min + np.arange(len(scan.ranges)) * scan.angle_increment
            normalized = (angles + math.pi) % (2.0 * math.pi) - math.pi
            self._scan_sector_masks = (
                np.abs(normalized) <= self.front_sector_rad,
                (normalized >= self.side_sector_min_rad)
                & (normalized <= self.side_sector_max_rad),
                (normalized <= -self.side_sector_min_rad)
                & (normalized >= -self.side_sector_max_rad),
            )
            self._scan_mask_geometry = geometry

        values = np.asarray(scan.ranges, dtype=np.float32)
        valid = np.isfinite(values) & (values > scan.range_min)
        front_mask, left_mask, right_mask = self._scan_sector_masks

        def sector_percentile(mask, fraction: float) -> Optional[float]:
            selected = values[valid & mask]
            if selected.size == 0:
                return None
            index = int(clamp(fraction, 0.0, 1.0) * (selected.size - 1))
            return float(np.partition(selected, index)[index])

        return (
            sector_percentile(front_mask, 0.05),
            sector_percentile(left_mask, 0.35),
            sector_percentile(right_mask, 0.35),
        )

    def clearances(
        self,
    ) -> Tuple[
        Optional[float],
        Optional[float],
        Optional[float],
        Optional[float],
        Optional[float],
    ]:
        laser_front, left, right = self.scan_clearances()
        camera_front = None
        if time.monotonic() - self.latest_camera_time <= self.camera_timeout:
            camera_front = self.latest_camera_front
        front_candidates = [
            value for value in (laser_front, camera_front) if value is not None
        ]
        front = min(front_candidates) if front_candidates else None
        return front, left, right, laser_front, camera_front

    def publish_status(
        self,
        front: Optional[float],
        left: Optional[float],
        right: Optional[float],
        laser_front: Optional[float],
        camera_front: Optional[float],
    ) -> None:
        payload = {
            "state": self.state,
            "motion_mode": self.motion_mode,
            "side": "left" if self.escape_side > 0.0 else "right" if self.escape_side < 0.0 else "none",
            "front_m": front,
            "laser_front_m": laser_front,
            "camera_front_m": camera_front,
            "left_m": left,
            "right_m": right,
            "path_active": self.path_active,
            "goal_distance_m": self.goal_distance,
            "heading_error_deg": round(self.heading_error_deg, 2),
            "lateral_authority": round(self.lateral_authority, 3),
        }
        text = json.dumps(payload, ensure_ascii=True, sort_keys=True)
        if text != self.last_status:
            self.status_pub.publish(String(data=text))
            self.last_status = text


def main(args=None) -> None:
    rclpy.init(args=args)
    node = LateralEscapeGuard()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
