def clamp(value: float, lower: float, upper: float) -> float:
    return max(lower, min(upper, value))


def percentile(values: Iterable[float], fraction: float) -> Optional[float]:
    data = sorted(v for v in values if math.isfinite(v) and v > 0.0)
    if not data:
        return None
    index = int(clamp(fraction, 0.0, 1.0) * (len(data) - 1))
    return data[index]


def choose_escape_side(
    left: Optional[float],
    right: Optional[float],
    min_clearance: float,
    min_advantage: float,
) -> float:
    """Return +1 for left, -1 for right, or 0 when no safe choice exists."""
    left_score = left if left is not None else 0.0
    right_score = right if right is not None else 0.0
    if max(left_score, right_score) < min_clearance:
        return 0.0
    if abs(left_score - right_score) < min_advantage:
        return 0.0
    return 1.0 if left_score > right_score else -1.0


def normalize_motion_mode(value: str) -> str:
    mode = str(value or "").strip().lower()
    aliases = {
        "omni": "omni",
        "holonomic": "omni",
        "forward": "forward_facing",
        "forward_facing": "forward_facing",
        "heading": "forward_facing",
    }
    return aliases.get(mode, "omni")


def forward_facing_velocity(
    vx: float,
    vy: float,
    wz: float,
    *,
    heading_kp: float,
    max_wz: float,
    lateral_ratio: float,
    lateral_max: float,
) -> Tuple[float, float, float]:
    """Blend a holonomic command into smooth forward-facing mecanum motion."""
    speed = math.hypot(vx, vy)
    if speed <= 0.08:
        # Tiny XY corrections near a goal are not a desired driving heading.
        # atan2(0.01, 0) used to add a large turn opposing Nav2's yaw control.
        return vx, vy, clamp(wz, -max_wz, max_wz)
    heading_error = math.atan2(vy, vx)
    angular = clamp(wz + heading_kp * heading_error, -max_wz, max_wz)
    forward = max(0.0, vx)
    lateral = clamp(
        vy * clamp(lateral_ratio, 0.0, 1.0),
        -abs(lateral_max),
        abs(lateral_max),
    )
    return forward, lateral, angular


def adaptive_lateral_authority(
    front: Optional[float],
    *,
    trigger_distance: float,
    release_distance: float,
    normal_ratio: float,
    obstacle_ratio: float,
    normal_max: float,
    obstacle_max: float,
) -> Tuple[float, float]:
    """Continuously release lateral authority as a front obstacle gets closer."""
    if front is None or front >= release_distance:
        pressure = 0.0
    elif front <= trigger_distance:
        pressure = 1.0
    else:
        span = max(release_distance - trigger_distance, 1e-3)
        pressure = (release_distance - front) / span
    pressure = clamp(pressure, 0.0, 1.0)
    ratio = normal_ratio + pressure * (obstacle_ratio - normal_ratio)
    maximum = normal_max + pressure * (obstacle_max - normal_max)
    return clamp(ratio, 0.0, 1.0), max(0.0, maximum)


