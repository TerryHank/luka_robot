"""Conservative choice between matching pose-torso and upper-mask ranges."""
if __package__:
    from .pose_match import match_pose
    from .stereo_mask_depth import masked_chest_geometry, masked_upper_body_geometry
    from .stereo_pose_torso import pose_torso_geometry
else:
    from pose_match import match_pose
    from stereo_mask_depth import masked_chest_geometry, masked_upper_body_geometry
    from stereo_pose_torso import pose_torso_geometry


def choose_visual_geometry(pose_geo, mask_geo, chest_geo=None):
    chest_geo = chest_geo or {'valid': False, 'reason': 'not_measured'}
    diagnostic = dict(pose_reason=pose_geo.get('reason'),
                      pose_pixels=pose_geo.get('valid_pixels'),
                      mask_reason=mask_geo.get('reason'),
                      mask_pixels=mask_geo.get('valid_pixels'),
                      mask_support=mask_geo.get('layer_support'),
                      mask_spread_m=mask_geo.get('depth_spread_m'),
                      mask_distance_m=mask_geo.get('distance_m'),
                      chest_reason=chest_geo.get('reason'),
                      chest_pixels=chest_geo.get('valid_pixels'),
                      chest_support=chest_geo.get('layer_support'),
                      chest_spread_m=chest_geo.get('depth_spread_m'),
                      chest_distance_m=chest_geo.get('distance_m'))
    if chest_geo.get('valid') and any(
            row.get('valid') and abs(row['distance_m']-chest_geo['distance_m']) > .25
            for row in (pose_geo, mask_geo)):
        return {'valid': False, 'reason': 'chest_torso_range_conflict',
                'source': 'stereo_pose_mask_torso', 'diagnostic': diagnostic}
    if pose_geo.get('valid') and mask_geo.get('valid'):
        if abs(pose_geo['distance_m']-mask_geo['distance_m']) > .25:
            return {'valid': False, 'reason': 'pose_mask_range_conflict',
                    'source': 'stereo_pose_mask_torso', 'diagnostic': diagnostic}
        return dict(pose_geo, reason='ok_pose_torso', diagnostic=diagnostic)
    if pose_geo.get('valid'):
        return dict(pose_geo, reason='ok_pose_torso', diagnostic=diagnostic)
    if (pose_geo.get('reason') == 'ambiguous_pose_torso_layers' and
            (not mask_geo.get('valid') or
             abs(mask_geo['distance_m']-chest_geo.get('distance_m', -100.)) <= .15) and
            chest_geo.get('valid') and
            chest_geo.get('valid_pixels', 0) >= 200 and
            chest_geo.get('layer_support', 0) >= .83 and
            chest_geo.get('depth_spread_m', 1.) <= .20):
        return dict(chest_geo, reason='ok_chest_mask_fallback',
                    diagnostic=diagnostic)
    if (mask_geo.get('valid') and mask_geo.get('layer_support', 0) >= .85 and
            mask_geo.get('valid_pixels', 0) >= 350 and
            mask_geo.get('depth_spread_m', 1.) <= .25 and
            pose_geo.get('reason') in ('torso_keypoints_unreliable',
                                       'torso_pose_geometry_unreliable',
                                       'insufficient_pose_torso_depth')):
        return dict(mask_geo, reason='ok_upper_mask_fallback', diagnostic=diagnostic)
    return dict(pose_geo, diagnostic=diagnostic)


def person_visual_geometry(depth, segments, poses, index, intrinsics, skew_s=0.):
    segment = segments[index]
    mask = segment.get('person_mask')
    if mask is None:
        return {'valid': False, 'reason': 'person_mask_missing',
                'source': 'stereo_pose_mask_torso'}
    pose, reason = match_pose(index, segments, poses)
    if pose is None:
        return {'valid': False, 'reason': reason,
                'source': 'stereo_pose_mask_torso'}
    pose_geo = pose_torso_geometry(depth, segment['bbox'], mask,
                                    pose['points_xy'], pose['point_logits'],
                                    intrinsics, skew_s)
    mask_geo = masked_upper_body_geometry(depth, segment['bbox'], mask,
                                           intrinsics, skew_s)
    chest_geo = masked_chest_geometry(depth, segment['bbox'], mask,
                                       intrinsics, skew_s)
    return choose_visual_geometry(pose_geo, mask_geo, chest_geo)
