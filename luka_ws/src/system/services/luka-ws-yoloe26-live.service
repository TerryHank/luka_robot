# /etc/systemd/system/luka-ws-yoloe26-live.service
[Unit]
Description=Luka S100 YOLOE-26n live object search
After=network-online.target luka-ws-vision.service
Wants=luka-ws-vision.service

[Service]
Environment=NX_CAMERA_SNAPSHOT_URL=http://127.0.0.1:8091/snapshot-hd.jpg
Type=simple
User=sunrise
Group=sunrise
WorkingDirectory=/home/sunrise/luka_ws/perception/yoloe26_live
ExecStart=/home/sunrise/luka_ws/perception/yoloe26_live/venv/bin/python /home/sunrise/luka_ws/perception/yoloe26_live/yoloe26_live_api.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
