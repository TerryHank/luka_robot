# /etc/systemd/system/luka-ws-agent.service
[Unit]
Description=Luka S100 local command agent (dry run)
After=network-online.target luka-ws-chat.service
Requires=luka-ws-chat.service

[Service]
Type=simple
User=sunrise
Group=sunrise
WorkingDirectory=/home/sunrise/luka_ws
ExecStart=/bin/bash /home/sunrise/luka_ws/start_nx_agent.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# /etc/systemd/system/luka-ws-agent.service.d/live-tools.conf
[Unit]
Description=Luka S100 local command agent (validated dashboard tools)
