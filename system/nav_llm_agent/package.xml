<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>nav_llm_agent</name>
  <version>0.1.0</version>
  <description>Luka L4 interaction gateway, voice runtime and L3 mission agent integration.</description>
  <maintainer email="yuxi@todo.todo">yuxi</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>ament_index_python</depend>
  <depend>std_msgs</depend>
  <depend>audio_msg</depend>
  <depend>std_srvs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>action_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>hotel_semantic_map_msgs</depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>alsa-utils</exec_depend>
  <exec_depend>pulseaudio-utils</exec_depend>
  <exec_depend>sensevoice_ros2</exec_depend>
  <exec_depend>hobot_tts</exec_depend>
  <exec_depend>hobot_xlm</exec_depend>
  <exec_depend>hobot_llamacpp</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
