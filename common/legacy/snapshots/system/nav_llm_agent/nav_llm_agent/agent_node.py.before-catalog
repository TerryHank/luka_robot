    def _build_system_prompt(self) -> str:
        lines = [
            "你是酒店管家机器人的工具选择器。根据用户一句话选择且只选择一个工具。",
            '只输出 JSON：{"tool":"工具名","arguments":{...}}，不要解释或 markdown。',
            "只有用户明确提出支持的任务时才能选择执行工具；无法理解、闲聊、识别残句一律选择 clarify，禁止猜测导航目标。",
            "可用工具：",
            *self._registry.prompt_lines(),
            "navigate 的 waypoint 只能从下面航点中选 name：",
        ]
        for name, spec in self._waypoints.items():
            if bool(spec.get("internal", False)):
                continue
            aliases = "/".join(spec.get("aliases", [])) or "-"
            lines.append(
                f"- {name}（别名：{aliases}；说明：{spec.get('description', '')}）"
            )
        lines.extend(
            [
                '示例：去厨房 -> {"tool":"navigate","arguments":{"waypoint":"kitchen"}}',
                '示例：开始巡航 -> {"tool":"patrol_start","arguments":{"mode":"loop"}}',
                '示例：去二层 -> {"tool":"elevator_enter","arguments":{"floor":"floor_2","destination":""}}',
                '示例：去二楼厨房 -> {"tool":"elevator_enter","arguments":{"floor":"floor_2","destination":"kitchen"}}',
                '示例：停止 -> {"tool":"cancel_all","arguments":{}}',
                '示例：据说 -> {"tool":"clarify","arguments":{"message":"没有听清，请重新说出完整命令"}}',
            ]
        )
        return "\n".join(lines)

