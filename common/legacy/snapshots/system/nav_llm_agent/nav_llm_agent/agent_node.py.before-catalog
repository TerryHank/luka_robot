            "你不能控制机器人，也不能声称已经执行导航、巡航、停车、乘电梯等动作。"
            "若用户明确要求控制小车，提示他使用明确命令，例如‘去厨房’或‘停止’。"
        )

    def _publish_status(self, text: str) -> None:
        self._status_pub.publish(String(data=text))
        self.get_logger().info(text)

    def _on_command(self, msg: String) -> None:
        text = (msg.data or "").strip()
        if not text:
            return
        if re.sub(r"[\s，。！？,.!?]", "", text) in ("清空聊天记忆", "清除聊天记忆", "忘掉刚才的对话"):
            self._chat_memory.clear()
            self._publish_status("speech: 聊天记忆已清空。")
            return
        corrected = normalize_navigation_asr(text)
        if corrected != text:
            self.get_logger().info(f"asr_correction: {text} -> {corrected}")
            text = corrected
        compact = re.sub(r"\s+", "", text)
        if any(token in compact for token in ("急停", "停止", "取消", "别走了")):
            self._publish_status(f"received: {text}")
            self._dispatch_tool("cancel_all", {}, text)
            return
        self._refresh_dashboard_waypoints()
        direct_waypoint = resolve_direct_navigation_command(text, self._waypoints)
        if direct_waypoint:
            self._publish_status(f"received: {text}")
            self._publish_status(f"direct_match: navigate {direct_waypoint}")
            self._dispatch_tool(
                "navigate", {"waypoint": direct_waypoint}, text
            )
            return
        if needs_voice_rephrase(text):
            self._publish_status("clarify: 没有听清，请说完整些。例如“带我去厨房”。")
            return
        direct_volume = resolve_direct_volume_command(text)
        if direct_volume:
            self._publish_status(f"received: {text}")
            self._dispatch_tool(direct_volume, {}, text)
            return
        if self._llm_future is not None:
            self._publish_status("busy: 大模型正在处理上一条指令")
            return
        self._llm_text = text
        self._llm_started_at = time.monotonic()
        self._publish_status(f"received: {text}")
        if not looks_like_robot_command(text):
            self._llm_mode = "chat"
            self._publish_status(f"routing: chat provider={self._chat_provider}")
            messages = self._chat_memory.messages(self._chat_system_prompt, text)
            self._chat_generation = self._chat_memory.generation
            self._chat_streamed = False
            generation = self._chat_generation
            self._llm_future = self._worker.submit(
                stream_chat_with_messages, self._chat_client, messages,
                lambda sentence: self._chat_chunks.put((generation, sentence))
            )
            return
        self._llm_mode = "command"
        self._llm_future = self._worker.submit(
            self._client.chat, self._system_prompt, text
        )

    def _drain_chat_chunks(self):
        while not self._chat_chunks.empty():
            generation, sentence = self._chat_chunks.get_nowait()
            if generation != self._chat_memory.generation:
                continue
            if not self._chat_streamed:
                self.get_logger().info(f"chat_first_sentence seconds={time.monotonic() - self._llm_started_at:.3f}")
            self._chat_streamed = True
            self._publish_status(f"chat_sentence: {sentence}")

    def _poll_llm(self) -> None:
        self._drain_chat_chunks()
        if self._llm_future is None or not self._llm_future.done():
            return
        future = self._llm_future
        self._llm_future = None
        try:
            if self._llm_mode in {"chat", "chat_fallback"} and self._chat_generation != self._chat_memory.generation:
                return  # Discard in-flight replies after an explicit memory clear.
            response = future.result().strip()
            self._drain_chat_chunks()
            if self._llm_mode in {"chat", "chat_fallback"}:
                self.get_logger().info(f"chat_timing seconds={time.monotonic() - self._llm_started_at:.3f}")
                # Keep status messages single-line because the voice gateway
                # subscribes to this topic and sends answer: text to TTS.
                answer = sanitize_chat_answer(response)
                if not answer:
                    raise ValueError("empty chat response")
                provider = "local" if self._llm_mode == "chat_fallback" else self._chat_provider
                self._chat_memory.add(self._llm_text, answer)
                prefix = 'answer_streamed' if self._chat_streamed else 'answer'
                self._publish_status(f"{prefix}[{provider}]: {answer}")
                return
            call = normalize_model_call(extract_json(response))
            self._dispatch_tool(call["tool"], call.get("arguments") or {}, self._llm_text)
        except Exception as exc:  # noqa: BLE001
            # A cloud-chat outage must never turn into a control-path outage.
            # Fail promptly instead of starting another slow generation.
            if self._llm_mode == "chat" and self._chat_client is not self._client:
                # rclpy loggers do not accept printf-style positional arguments.
                # Keep this path non-fatal: a transient DNS/network failure must
                # fall back to the on-board model instead of killing the router.
                self.get_logger().warning(
                    f"cloud chat unavailable: {type(exc).__name__}"
                )
                # Do not add a second, potentially minute-long local generation
                # after a cloud timeout. Navigation still uses the local route.
                self._publish_status("speech: 网络回答暂时没连上，请稍后再问我。")
                return
            self._publish_status(f"llm_error: {exc}")

    def _dispatch_tool(self, name: str, arguments: Dict[str, Any], source: str = "") -> None:
        if name == "clarify":
            self._publish_status(f"clarify: {arguments.get('message') or '请说清楚任务'}")
            return
        if self._pending_kind and name not in {
            "cancel_all",
            "elevator_cancel",
            "robot_status",
        }:
            self._publish_status(
                f"busy: 当前正在执行 {self._pending_kind}，请先说“停止”"
            )
            return
        try:
            values = self._registry.validate_call(name, arguments)
            if not tool_is_grounded(name, source):
                raise ValueError("原始指令没有明确要求执行该运动任务")
            if name == "navigate":
                values["waypoint"] = resolve_grounded_waypoint(
                    values["waypoint"], source, self._waypoints
                )
        except ValueError as exc:
            self._publish_status(f"clarify: {exc}")
            return
        capability = self._registry.capabilities[name]
        if capability.workflow:
            self._workflow.start(capability.workflow, values)
            self._publish_status(f"workflow_start: {capability.workflow}")
            self._run_workflow()
            return
        self._execute_handler(capability.handler, values)

    def _correct_waypoint(self, picked: str, source: str) -> str:
        return resolve_grounded_waypoint(picked, source, self._waypoints)

    def _run_workflow(self) -> None:
        while self._workflow.active:
            step = self._workflow.current()
            if step is None:
                break
            handler = str(step.get("handler") or "")
            arguments = dict(step.get("arguments") or {})
            self._publish_status(
                f"workflow_step: {self._workflow.name} "
                f"{self._workflow.index + 1} {handler}"
            )
            pending = self._execute_handler(handler, arguments, workflow_step=True)
            if pending:
                return
            if self._workflow.advance():
                self._publish_status(f"workflow_done: {self._workflow.name}")
                return

    def _complete_pending(self, success: bool, message: str) -> None:
        self._pending_kind = ""
        self._publish_status(message)
        if not self._workflow.active:
            return
        if not success:
            name = self._workflow.name
            if self._transfer_state.phase in {
                "exiting",
                "switching_map",
                "localizing",
                "navigating",
            }:
                self._fail_transfer(message)
            else:
                self._workflow.cancel()
            self._publish_status(f"workflow_failed: {name}")
            return
        if self._workflow.advance():
            self._publish_status(f"workflow_done: {self._workflow.name}")
        else:
            self._run_workflow()

    def _execute_handler(
        self, handler: str, arguments: Dict[str, Any], workflow_step: bool = False
    ) -> bool:
        del workflow_step
        if self._dry_run:
            self._publish_status(f"dry_run: {handler} {arguments}")
            return False
        handlers = {
            "navigate": self._handle_navigate,
            "patrol_start": self._handle_patrol_start,
            "patrol_stop": lambda _args: self._publish_empty(
                "patrol_stop", "巡航已停止"
            ),
            "patrol_pause": lambda _args: self._publish_empty(
                "patrol_pause", "巡航已暂停"
            ),
            "patrol_resume": lambda _args: self._publish_empty(
                "patrol_resume", "巡航已恢复"
            ),
            "go_home": lambda _args: self._publish_empty(
                "home", "已发送返回充电点"
            ),
            "mission_pause": lambda _args: self._call_service(
                "mission_pause", "酒店任务已暂停"
            ),
            "mission_resume": lambda _args: self._call_service(
                "mission_resume", "酒店任务已恢复"
            ),
            "cancel_all": lambda _args: self._cancel_all(),
            "elevator_cancel": lambda _args: self._cancel_elevator(),
            "elevator_resume": lambda _args: self._resume_failed_transfer(),
            "elevator_command": self._handle_elevator_command,
            "elevator_entry_start": lambda _args: self._call_service(
                "entry_start", "进电梯控制器已启动", pending=True
            ),
            "wait_elevator_entered": self._wait_elevator_entered,
            "wait_elevator_arrival": self._wait_elevator_arrival,
            "switch_floor": self._handle_switch_floor,
            "robot_status": lambda _args: self._report_status(),
            "volume_up": lambda _args: self._set_voice_volume("volume_up", "音量已调大"),
            "volume_down": lambda _args: self._set_voice_volume("volume_down", "音量已调小"),
        }
        callback = handlers.get(handler)
        if callback is None:
            self._publish_status(f"executor_error: 未实现处理器 {handler}")
            return False
        return bool(callback(arguments))

    def _set_voice_volume(self, command: str, message: str) -> bool:
        self._tool_publishers["voice_control"].publish(String(data=command))
        self._publish_status(message)
        return False

    def _refresh_dashboard_waypoints(self) -> None:
        """Use the same enabled POIs as the dashboard, refreshed for every request."""
        try:
            context = json.loads(self._active_floor_context_file.read_text(encoding="utf-8"))
            floor = str(context.get("floor_id") or "")
            if not re.fullmatch(r"floor_[A-Za-z0-9_-]+", floor):
                raise ValueError("invalid active floor")
            root = self._active_floor_context_file.parent.parent
            candidates = [root / "config" / "semantic" / floor / "pois.yaml",
                          root / "semantic" / floor / "pois.yaml"]
            path = next((p for p in candidates if p.exists()), candidates[0])
            document = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
            items = {}
            for poi in document.get("pois", []):
                if not poi.get("enabled", True):
                    continue
                name = str(poi["id"])
                label = str(poi.get("display_name") or name)
                items[name] = dict(name=name, aliases=[label], description=label,
                                   x=float(poi["x"]), y=float(poi["y"]),
                                   yaw=float(poi.get("yaw", 0)), internal=False,
                                   dashboard_poi=True, floor_id=floor)
            self._waypoints = items
        except (OSError, ValueError, KeyError, TypeError, yaml.YAMLError) as exc:
            # Never fall back to example coordinates when the live database fails.
            self._waypoints = {}
            self.get_logger().warning(f"POI database unavailable: {exc}")
        self._system_prompt = self._build_system_prompt()

    def _handle_navigate(self, arguments: Dict[str, Any]) -> bool:
        name = str(arguments.get("waypoint") or "")
        previous = self._waypoints.get(name, {})
        self._refresh_dashboard_waypoints()
        waypoint = self._waypoints.get(name)
        if previous.get("floor_id") != (waypoint or {}).get("floor_id"):
            self._complete_pending(False, "clarify: 楼层已切换，请重新下达导航指令")
            return True
        if waypoint is None:
            self._complete_pending(False, f"clarify: 未知航点 {name!r}")
            return True
        if waypoint.get("dashboard_poi"):
            current = self._spoken_nav_target
            if self._last_mission_status in {"paused", "canceled", "failed", "succeeded", "idle"} and current and current.get("started"):
                current["started"] = False
                current["waiting_start"] = False
            if current and current["id"] == name and current.get("started"):
                self._publish_status(f"speech: 当前导航任务的目的地就是{waypoint['description']}。")
                return False
            if self._requested_nav_target is not None or (current and current.get("waiting_start")):
                self._publish_status("speech: 上一条导航请求仍在等待确认，请先检查状态；需要取消时说停止。")
                return False
            if self._dashboard_goal_pub.get_subscription_count() == 0:
                self._complete_pending(False, "nav2 not ready: 导航任务服务尚未启动")
                return True
            self._requested_nav_target = {"id": name, "label": waypoint['description'], "started": False,
                                          "waiting_start": True, "wait_deadline": time.monotonic()+10.0}
            if self._spoken_nav_target is None or not self._spoken_nav_target.get("started"):
                self._spoken_nav_target = self._requested_nav_target
            self._dashboard_goal_pub.publish(String(data=name))
            self._publish_status(f"submitted: 正在请求前往{waypoint['description']}，等待任务确认")
            return False
        if "待标定" in str(waypoint.get("description") or ""):
            self._complete_pending(
                False,
                f"waypoint_unconfigured: {name} 尚未标定，无法安全导航",
            )
            return True
        return self._send_navigation_pose(
            name,
            float(waypoint["x"]),
            float(waypoint["y"]),
            float(waypoint["yaw"]),
        )

    def _check_navigation_feedback_timeout(self):
        seen = set()
        for target in (self._requested_nav_target, self._spoken_nav_target):
            if target is None or id(target) in seen:
                continue
            seen.add(id(target))
            if (not target.get("started") and target.get("wait_deadline") is not None
                    and time.monotonic() >= target["wait_deadline"]):
                target.pop("wait_deadline", None)
                # No resubmission or automatic cancellation: missing feedback
                # is not evidence that the robot did or did not start moving.
                self._publish_status("speech: 还没有收到导航启动确认，请检查小车状态；不要重复发送，需要取消时说停止。")

    def _on_mission_safety_status(self, msg: String) -> None:
        try:
            status = json.loads(msg.data)
        except (TypeError, ValueError):
            return
        if not isinstance(status, dict) or status.get("state") != "imu_guard":
            return
        message = status.get("message")
        if not isinstance(message, str) or not message:
            return
        if self._spoken_nav_target is not None:
            self._spoken_nav_target["started"] = False
            self._spoken_nav_target["waiting_start"] = False
            self._spoken_nav_target.pop("wait_deadline", None)
        self._publish_status("speech: " + message)

    def _on_mission_goal_status(self, msg: String) -> None:
        try:
            status = json.loads(msg.data)
        except (TypeError, ValueError):
            return
        target = self._requested_nav_target
        if not isinstance(status, dict) or not target or status.get("destination_id") != target["id"]:
            return
        if status.get("state") == "rejected":
            # Do not clear an already-running target on a duplicate request.
            if self._spoken_nav_target is target and not target.get("started"):
                self._spoken_nav_target = None
            self._publish_status("speech: " + str(status.get("message") or "导航请求未被接受，请重试。"))
        elif status.get("state") == "accepted":
            self._spoken_nav_target = target
            target["wait_deadline"] = time.monotonic()+20.0
            self._publish_status("submitted: 任务已接收，等待导航启动")
        self._requested_nav_target = None

    def _on_named_nav_status(self, msg: String) -> None:
        target = self._spoken_nav_target
        if target is None:
            return
        try:
            status = json.loads(msg.data)
        except (TypeError, ValueError):
            return
        if not isinstance(status, dict) or status.get("destination_id") != target["id"]:
            return
        state = status.get("state")
        label = target["label"]
        if state == "navigating" and not target["started"]:
            target["started"] = True
            target["waiting_start"] = False
            self._publish_status(f"speech: 好，这就带你去{label}。")
        elif state in {"succeeded", "failed", "cancelled", "rejected_busy"}:
            self._spoken_nav_target = None
            if self._requested_nav_target is target:
                self._requested_nav_target = None
            phrases = {
                "succeeded": f"到{label}啦。",
                "failed": navigation_failure_text(str(status.get("failure_code", "")), label),
                "cancelled": "导航已取消。",
                "rejected_busy": "当前还有导航任务，请先停止再试。",
            }
            self._publish_status(f"speech: {phrases[state]}")

    def _send_navigation_pose(
        self, name: str, x: float, y: float, yaw: float
    ) -> bool:
        if not self._nav_client.wait_for_server(timeout_sec=0.5):
            self._complete_pending(
                False, "nav2 not ready: navigate_to_pose unavailable"
            )
            return True
        pose = PoseStamped()
        pose.header.frame_id = self._frame_id
        pose.header.stamp = self.get_clock().now().to_msg()
        pose.pose.position.x = x
        pose.pose.position.y = y
        qx, qy, qz, qw = yaw_to_quat(yaw)
        pose.pose.orientation.x = qx
        pose.pose.orientation.y = qy
        pose.pose.orientation.z = qz
        pose.pose.orientation.w = qw
        goal = NavigateToPose.Goal()
        goal.pose = pose
        self._pending_kind = f"navigation:{name}"
        future = self._nav_client.send_goal_async(goal)
        future.add_done_callback(
            lambda fut, target=name: self._on_goal_response(fut, target)
        )
        self._publish_status(f"sending: navigate {name}")
        return True

    def _on_goal_response(self, future, name: str) -> None:
        try:
            handle = future.result()
        except Exception as exc:  # noqa: BLE001
            self._complete_pending(False, f"goal_error: {exc}")
            return
        if handle is None or not handle.accepted:
            self._complete_pending(False, f"goal rejected: {name}")
            return
        self._current_goal = handle
        result_future = handle.get_result_async()
        result_future.add_done_callback(
            lambda fut, target=name: self._on_nav_result(fut, target)
        )

    def _on_nav_result(self, future, name: str) -> None:
        try:
            status = future.result().status
        except Exception as exc:  # noqa: BLE001
            self._complete_pending(False, f"navigation_error: {exc}")
            return
        self._current_goal = None
        success = status == GoalStatus.STATUS_SUCCEEDED
        if name.startswith("floor_target:"):
            if success:
                state = self._transfer_state
                self._set_transfer_state(
                    TransferState(**{**state.__dict__, "phase": "complete"})
                )
                self._complete_pending(
                    True,
                    f"floor_transfer_done: 已到达 {state.floor_id} 的 {state.destination_id}",
                )
            else:
                self._fail_transfer(f"目标航点导航失败 status={status}")
            return
        if (
            not self._workflow.active
            and name == self._exit_waypoint
            and self._transfer_state.phase == "exiting"
        ):
            self._pending_kind = ""
            self._publish_status(f"navigation: {name} status={status}")
            if success:
                self._handle_switch_floor(
                    {
                        "floor": self._transfer_state.floor_id,
                        "destination": self._transfer_state.destination_key,
                    }
                )
            else:
                self._fail_transfer("出梯导航失败")
            return
        self._complete_pending(success, f"navigation: {name} status={status}")

    def _handle_patrol_start(self, arguments: Dict[str, Any]) -> bool:
        mode = str(arguments.get("mode") or "loop")
        key = "patrol_once" if mode == "once" else "patrol_loop"
        return self._publish_empty(
            key, f"已启动{'单次' if mode == 'once' else '循环'}巡航"
        )

    def _publish_empty(self, key: str, message: str) -> bool:
        self._tool_publishers[key].publish(Empty())
        self._publish_status(message)
        return False

    def _call_service(self, key: str, message: str, pending: bool = False) -> bool:
        client = self._tool_clients[key]
        if not client.wait_for_service(timeout_sec=0.5):
            self._complete_pending(False, f"service unavailable: {key}")
            return True
        future = client.call_async(EmptyService.Request())
        if pending:
            self._pending_kind = f"service:{key}"
            future.add_done_callback(
                lambda fut, label=message: self._on_service_result(fut, label)
            )
            return True
        self._publish_status(message)
        return False

    def _on_service_result(self, future, message: str) -> None:
        try:
            future.result()
            self._complete_pending(True, message)
        except Exception as exc:  # noqa: BLE001
            self._complete_pending(False, f"service_error: {exc}")

    def _handle_elevator_command(self, arguments: Dict[str, Any]) -> bool:
        floor = str(arguments.get("floor") or "")
        payload = json.dumps(
            {"command": "go", "floor_id": floor}, ensure_ascii=False
        )
        self._elevator_pub.publish(String(data=payload))
        self._publish_status(f"elevator: 已请求 {floor}")
        return False

    def _wait_elevator_entered(self, _arguments: Dict[str, Any]) -> bool:
        self._pending_kind = "elevator_entered"
        self._publish_status("elevator: 等待门打开并进入")
        return True

    def _on_elevator_entered(self, _msg: Empty) -> None:
        if self._pending_kind == "elevator_entered":
            self._complete_pending(True, "elevator: 已进入电梯")
        else:
            self._publish_status("elevator: 已进入电梯")

    def _wait_elevator_arrival(self, arguments: Dict[str, Any]) -> bool:
        try:
            target = load_floor_target(
                self._building_config_file,
                str(arguments.get("floor") or ""),
                str(arguments.get("destination") or ""),
            )
        except (KeyError, OSError, TypeError, ValueError) as exc:
            self._complete_pending(False, f"elevator: 目标楼层配置错误: {exc}")
            return True
        self._set_transfer_state(state_from_target(target, "waiting_arrival"))
        self._pending_kind = f"elevator_arrival:{target.floor_id}"
        self._publish_status(
            f"elevator: 已进入，等待手动协议确认 {target.floor_id} 到达且门开"
        )
        return True

    def _on_elevator_status(self, msg: String) -> None:
        if self._transfer_state.phase != "waiting_arrival":
            return
        try:
            status = json.loads(msg.data)
        except (TypeError, ValueError, json.JSONDecodeError):
            return
        if not isinstance(status, dict):
            return
        arrived = (
            status.get("available") is True
            and str(status.get("door") or "").casefold() == "open"
            and str(status.get("floor_id") or "") == self._transfer_state.floor_id
            and status.get("car_present") is True
            and str(status.get("motion") or "").casefold() == "stopped"
        )
        if not arrived:
            return
        self._set_transfer_state(
            TransferState(**{
                **self._transfer_state.__dict__,
                "phase": "exiting",
            })
        )
        self._publish_status(
            f"elevator: {self._transfer_state.floor_id} 已到达且门开，开始导航出梯"
        )
        if self._workflow.active:
            self._complete_pending(True, "elevator: 到站开门确认通过")
        else:
            self._pending_kind = ""
            self._start_exit_resume_workflow()

    def _handle_switch_floor(self, arguments: Dict[str, Any]) -> bool:
        # A floor change is a transaction boundary: stop any autonomous route
        # before replacing map-relative data.
        self._tool_publishers["patrol_stop"].publish(Empty())
        try:
            target = load_floor_target(
                self._building_config_file,
                str(arguments.get("floor") or self._transfer_state.floor_id),
                str(
                    arguments.get("destination")
                    or self._transfer_state.destination_key
                ),
            )
            state = state_from_target(target, "switching_map")
            self._set_transfer_state(state)
            pose_file = (
                f"/home/nvidia/ddsm_car_ws/config/llm_transfer_pose_{target.floor_id}.yaml"
            )
            save_initial_pose_file(pose_file, target)
        except (KeyError, OSError, TypeError, ValueError) as exc:
            self._fail_transfer(f"切图参数错误: {exc}")
            return True

        if not self._load_map_client.wait_for_service(timeout_sec=1.0):
            self._fail_transfer("热切图失败: /map_server/load_map 不可用")
            return True
        self._hot_switch_target = target
        self._pending_kind = f"hot_switch_reset:{target.floor_id}"
        self._publish_status(
            f"floor_transfer: 已出梯，准备热切换 {target.floor_id} 地图"
        )
        reset = {
            "floor_id": target.floor_id,
            "map_file": target.map_file,
            "last_pose_file": (
                f"/home/nvidia/ddsm_car_ws/config/last_amcl_pose_{target.floor_id}.yaml"
            ),
        }
        self._hot_switch_pub.publish(
            String(data=json.dumps(reset, ensure_ascii=False))
        )
        return True

    def _on_localization_status(self, msg: String) -> None:
        if msg.data == "failed" and self._transfer_state.phase == "localizing":
            self._fail_transfer("目标楼层定位吸附失败")
            return
        if (
            msg.data != "hot_switch_ready"
            or not self._pending_kind.startswith("hot_switch_reset:")
            or self._hot_switch_target is None
        ):
            return
        self._pending_kind = f"loading_map:{self._hot_switch_target.floor_id}"
        request = LoadMap.Request()
        request.map_url = self._hot_switch_target.map_file
        future = self._load_map_client.call_async(request)
        future.add_done_callback(self._on_hot_map_loaded)
        self._publish_status(
            f"floor_transfer: AMCL 已复位，正在加载 {self._hot_switch_target.floor_id} 地图"
        )

    def _on_hot_map_loaded(self, future) -> None:
        try:
            response = future.result()
        except Exception as exc:  # noqa: BLE001
            self._fail_transfer(f"热切图服务异常: {exc}")
            return
        if response is None or int(response.result) != int(LoadMap.Response.RESULT_SUCCESS):
            code = getattr(response, "result", "none")
            self._fail_transfer(f"热切图失败: LoadMap result={code}")
            return
        target = self._hot_switch_target
        if target is None:
            self._fail_transfer("热切图内部状态丢失")
            return
        self._semantic_floor_ready = False
        self._localization_floor_ready = False
        self._current_floor_id = target.floor_id
        self._set_transfer_state(state_from_target(target, "localizing"))
        self._pending_kind = f"localizing:{target.floor_id}"
        self._floor_switch_started = time.monotonic()
        context = {
            "floor_id": target.floor_id,
            "map_file": target.map_file,
            "semantic_manifest_file": target.semantic_manifest_file,
            "patrol_route_file": target.patrol_route_file,
            "source": "nav_llm_agent",
        }
        self._floor_context_pub.publish(
            String(data=json.dumps(context, ensure_ascii=False, separators=(",", ":")))
        )
        self._tool_publishers["patrol_stop"].publish(Empty())
        if target.patrol_route_file:
            self._tool_publishers["patrol_load_route"].publish(
                String(data=target.patrol_route_file)
            )
        pose = PoseWithCovarianceStamped()
        pose.header.frame_id = "map"
        pose.header.stamp = self.get_clock().now().to_msg()
        pose.pose.pose.position.x = target.initial_x
        pose.pose.pose.position.y = target.initial_y
        qx, qy, qz, qw = yaw_to_quat(target.initial_yaw)
        pose.pose.pose.orientation.x = qx
        pose.pose.pose.orientation.y = qy
        pose.pose.pose.orientation.z = qz
        pose.pose.pose.orientation.w = qw
        pose.pose.covariance[0] = 0.04
        pose.pose.covariance[7] = 0.04
        pose.pose.covariance[35] = 0.09
        self._hot_switch_pose = pose
        self._hot_switch_pose_republish = 5
        self._initial_pose_pub.publish(pose)
        empty_request = ClearEntireCostmap.Request()
        if self._clear_global_client.service_is_ready():
            self._clear_global_client.call_async(empty_request)
        if self._clear_local_client.service_is_ready():
            self._clear_local_client.call_async(ClearEntireCostmap.Request())
        if self._nomotion_client.service_is_ready():
            self._nomotion_client.call_async(EmptyService.Request())
        self._publish_status(
            f"floor_transfer: {target.floor_id} 地图已加载，等待语义上下文和雷达定位同时就绪"
        )

    def _republish_hot_switch_pose(self) -> None:
        if self._hot_switch_pose_republish <= 0 or self._hot_switch_pose is None:
            return
        self._hot_switch_pose.header.stamp = self.get_clock().now().to_msg()
        self._initial_pose_pub.publish(self._hot_switch_pose)
        self._hot_switch_pose_republish -= 1

    def _set_transfer_state(self, state: TransferState) -> None:
        self._transfer_state = state
        save_transfer_state(self._transfer_state_file, state)

    def _fail_transfer(self, reason: str) -> None:
        failed = TransferState(
            **{**self._transfer_state.__dict__, "phase": "failed"}
        )
        self._set_transfer_state(failed)
        self._workflow.cancel()
        self._pending_kind = ""
        self._publish_status(f"floor_transfer_failed: {reason}")

    def _resume_failed_transfer(self) -> bool:
        state = self._transfer_state
        if state.phase not in {"failed", "exiting"} or not state.floor_id:
            self._publish_status("floor_transfer: 没有可继续的出梯任务")
            return False
        self._set_transfer_state(
            TransferState(**{**state.__dict__, "phase": "exiting"})
        )
        return self._start_exit_resume_workflow()

    def _start_exit_resume_workflow(self) -> bool:
        state = self._transfer_state
        self._workflow.start(
            "elevator_exit_resume",
            {
                "floor": state.floor_id,
                "destination": state.destination_key,
            },
        )
        self._publish_status("workflow_start: elevator_exit_resume")
        self._run_workflow()
        return True

    def _resume_transfer(self) -> None:
        if self._resume_checked:
            return
        state = self._transfer_state
        if state.phase == "waiting_arrival":
            self._pending_kind = f"elevator_arrival:{state.floor_id}"
            self._publish_status(
                f"floor_transfer_resume: 等待手动协议确认 {state.floor_id} 到达且门开"
            )
            self._resume_checked = True
            return
        if state.phase == "exiting":
            self._resume_checked = True
            self._publish_status("floor_transfer_resume: 继续两段式 Nav2 出梯")
            self._start_exit_resume_workflow()
            return
        if state.phase in {"switching_map", "localizing"}:
            self._resume_checked = True
            self._publish_status(
                f"floor_transfer_resume: 重新执行 {state.floor_id} 热切图校位"
            )
            self._handle_switch_floor(
                {"floor": state.floor_id, "destination": state.destination_key}
            )
            return
        if state.phase == "navigating":
            self._pending_kind = f"target_navigation:{state.destination_id}"
            self._navigate_transfer_target()
            self._publish_status(
                f"floor_transfer_resume: 继续前往目标 {state.destination_id}"
            )
            self._resume_checked = True
            return
        self._resume_checked = True

    def _on_localization_ready(self, msg: Bool) -> None:
        state = self._transfer_state
        if not msg.data or state.phase != "localizing":
            return
        self._localization_floor_ready = True
        self._try_finish_floor_context_switch()

    def _on_semantic_map_status(self, msg: SemanticMapStatus) -> None:
        state = self._transfer_state
        if state.phase != "localizing" or not state.floor_id:
            return
        if not msg.ready or msg.floor_id != state.floor_id:
            return
        self._semantic_floor_ready = True
        self._publish_status(
            f"floor_transfer: {state.floor_id} 语义地图已同步"
        )
        self._try_finish_floor_context_switch()

    def _try_finish_floor_context_switch(self) -> None:
        state = self._transfer_state
        if (
            state.phase != "localizing"
            or not self._localization_floor_ready
            or not self._semantic_floor_ready
        ):
            return
        navigating = TransferState(**{**state.__dict__, "phase": "navigating"})
        self._set_transfer_state(navigating)
        self._persist_active_floor_context(state)
        self._pending_kind = f"target_navigation:{state.destination_id}"
        self._publish_status(
            f"floor_transfer: 定位吸附完成，前往目标 {state.destination_id}"
        )
        self._navigate_transfer_target()

    def _persist_active_floor_context(self, state: TransferState) -> None:
        payload = {
            "floor_id": state.floor_id,
            "map_file": state.map_file,
            "semantic_manifest_file": state.semantic_manifest_file,
            "patrol_route_file": state.patrol_route_file,
        }
        target = self._active_floor_context_file
        target.parent.mkdir(parents=True, exist_ok=True)
        temporary = target.with_suffix(target.suffix + ".tmp")
        temporary.write_text(
            json.dumps(payload, ensure_ascii=False, indent=2) + "\n",
            encoding="utf-8",
        )
        temporary.replace(target)

    def _check_floor_context_timeout(self) -> None:
        if (
            self._transfer_state.phase != "localizing"
            or self._floor_switch_started <= 0.0
            or time.monotonic() - self._floor_switch_started
            <= self._floor_context_timeout
        ):
            return
        missing = []
        if not self._semantic_floor_ready:
            missing.append("语义地图")
        if not self._localization_floor_ready:
            missing.append("定位")
        self._floor_switch_started = 0.0
        self._fail_transfer("楼层上下文切换超时，未就绪: " + "、".join(missing))

    def _navigate_transfer_target(self) -> bool:
        state = self._transfer_state
        return self._send_navigation_pose(
            f"floor_target:{state.destination_id}",
            state.target_x,
            state.target_y,
            state.target_yaw,
        )

    def _cancel_elevator(self) -> bool:
        if self._tool_clients["entry_cancel"].service_is_ready():
            self._tool_clients["entry_cancel"].call_async(EmptyService.Request())
        self._workflow.cancel()
        self._pending_kind = ""
        self._set_transfer_state(TransferState())
        self._publish_status("elevator: 已取消进梯流程")
        return False

    def _cancel_all(self) -> bool:
        self._requested_nav_target = None
        if self._spoken_nav_target is not None:
            self._spoken_nav_target.pop("wait_deadline", None)
            self._spoken_nav_target["waiting_start"] = False
        if self._current_goal is not None:
            self._current_goal.cancel_goal_async()
            self._current_goal = None
        self._tool_publishers["patrol_stop"].publish(Empty())
        for key in ("entry_cancel", "mission_cancel"):
            if self._tool_clients[key].service_is_ready():
                self._tool_clients[key].call_async(EmptyService.Request())
        self._workflow.cancel()
        self._pending_kind = ""
        self._set_transfer_state(TransferState())
        self._publish_status("cancel: 已取消导航、巡航、电梯和酒店任务")
        return False

    def _report_status(self) -> bool:
        self._publish_status(
            "robot_status: "
            f"执行={self._pending_kind or '空闲'}；巡航={self._last_patrol_status}；"
            f"任务={self._last_mission_status}；进梯={self._last_entry_status}；"
            f"跨楼层={self._transfer_state.phase}"
        )
        return False

    def _on_waypoints_reload(self, _msg: Empty) -> None:
        self._frame_id, self._waypoints = load_waypoints(self._waypoints_file)
        self._system_prompt = self._build_system_prompt()
        self._publish_status(
            f"waypoints: 已重新加载 {len(self._waypoints)} 个航点"
        )

    def _on_entry_status(self, msg: String) -> None:
        self._last_entry_status = msg.data
        if self._pending_kind == "elevator_entered":
            try:
                state = str(json.loads(msg.data).get("state") or "")
            except (TypeError, ValueError, json.JSONDecodeError):
                return
            if state == "failed":
                self._complete_pending(False, "elevator: 进梯失败")

    def _on_mission_status(self, msg: String) -> None:
        self._last_mission_status = msg.data

    def _on_patrol_status(self, msg: String) -> None:
        self._last_patrol_status = msg.data

    def destroy_node(self):
        self._worker.shutdown(wait=False, cancel_futures=True)
        return super().destroy_node()


def main(args=None):
    instance_lock = acquire_instance_lock()
    if instance_lock is None:
        print("nav_llm_agent already running; refusing a second command router")
        return
    rclpy.init(args=args)
    node = NavLlmAgent()
    try:
        rclpy.spin(node)
    except (KeyboardInterrupt, ExternalShutdownException):
        pass
    finally:
        node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()
        instance_lock.close()


if __name__ == "__main__":
    main()
