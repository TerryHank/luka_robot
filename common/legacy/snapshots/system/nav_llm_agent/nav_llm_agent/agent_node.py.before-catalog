}


def tool_is_grounded(name: str, source: str) -> bool:
    """Reject model-selected motion unless the original utterance requests it."""
    hints = MOTION_TOOL_HINTS.get(name)
    if hints is None:
        return True
    compact = re.sub(r"\s+", "", source or "").lower()
    return any(hint.lower() in compact for hint in hints)


def resolve_grounded_waypoint(
    picked: str, source: str, waypoints: Dict[str, Dict[str, Any]]
) -> str:
    """Resolve a public waypoint only when its name/alias occurs in user text."""
    compact = re.sub(r"\s+", "", source or "").lower()
    matches = []
    for name, spec in waypoints.items():
        if bool(spec.get("internal", False)):
            continue
        tokens = [name, *spec.get("aliases", [])]
        if any(
            str(token).strip().lower() in compact
            for token in tokens
            if str(token).strip()
        ):
            matches.append(name)
    if picked in matches:
        return picked
    if len(matches) == 1:
        return matches[0]
    raise ValueError("未在原始指令中找到唯一、明确的目标航点")


DIRECT_NAV_RE = re.compile(
    r"^(?:(?:请|麻烦)?|(?:你能|你可以|能不能|可以)?)(?:带我去|送我去|导航到?|前往|我要去|我想去|过去|去|到)"
)
DIRECT_NAV_NEGATIONS = ("不去", "别去", "不要去", "不用去", "不想去")


def normalize_navigation_asr(text: str) -> str:
    """Only correct a known homophone in a complete, explicit room command."""
    match = re.fullmatch(
        r"((?:请|麻烦)?(?:带我去|送我去|导航到|前往|我要去|我想去|去|到))卧士([吧。！!？?，,\s]*)", text.strip())
    if match:
        return match.group(1) + "卧室" + match.group(2)
    return text

# Routing must be conservative: a false positive may move the robot, while a
# false negative only produces a spoken answer.  Direct waypoint matching above
# still takes priority and bypasses this list.
ROBOT_COMMAND_RE = re.compile(
    r"^(?:请|麻烦|帮我)?(?:"
    r"去|到|前往|导航|带我去|送我去|我要去|我想去|你能带我去|你可以带我去|能不能带我去|可以带我去|"
    r"开始(?:巡航|巡逻|任务)|(?:停止|暂停|继续|恢复|取消)(?:巡航|巡逻|任务|导航)?|"
    r"回(?:充电(?:桩|点)?|家|起点)|(?:查询|报告)(?:机器人)?状态|"
    r"(?:加大|调大|提高|减小|调小|降低)(?:音量|声音)|(?:音量|声音)(?:大一点|小一点)|"
    r"进入?电梯|去[一二三四五六七八九0-9]+(?:楼|层)"
    r")"
)


def looks_like_robot_command(source: str) -> bool:
    """Whether an utterance explicitly asks the robot to take an action."""
    compact = re.sub(r"\s+", "", source or "")
    return bool(ROBOT_COMMAND_RE.search(compact))


def resolve_direct_volume_command(source: str) -> Optional[str]:
    compact = re.sub(r"\s+", "", source or "")
    if any(token in compact for token in ("加大音量", "调大音量", "提高音量", "声音大一点", "音量大一点")):
        return "volume_up"
    if any(token in compact for token in ("减小音量", "调小音量", "降低音量", "声音小一点", "音量小一点")):
        return "volume_down"
    return None


def needs_voice_rephrase(source: str) -> bool:
    """Keep low-information ASR fragments out of the generative chat path."""
    compact = re.sub(r"\s+", "", source or "")
    if compact in {"去", "到", "带我", "带我去", "带子", "导航", "前往"}:
        return True
    # Short ASR fragments such as "骗的" are too ambiguous for a robot to
    # infer safely; asking again is preferable to inventing an interpretation.
    return len(compact) <= 2 and compact not in {"你好", "再见"}


def sanitize_chat_answer(text: str) -> str:
    """Keep a short complete reply, including substance after an acknowledgement."""
    answer = re.sub(r"\s+", " ", text or "").strip()
    sentences = [part.strip() for part in re.split(r"(?<=[。！？])", answer) if part.strip()]
    return "".join(sentences[:2])[:120].strip(" ，、")


def load_chat_api_key(env_name: str) -> str:
    value = os.environ.get(env_name, "").strip()
    if value:
        return value
    try:
        with open("/home/nvidia/.config/nav_llm_agent/qwen-token-plan.env", encoding="utf-8") as stream:
            for line in stream:
                key, sep, candidate = line.strip().partition("=")
                if sep and key == env_name:
                    return candidate.strip()
    except OSError:
        pass
    return ""


def acquire_instance_lock():
    try:
        handle = open(f"/run/user/{os.getuid()}/nav_llm_agent.lock", "w", encoding="utf-8")
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
        return handle
    except OSError:
        return None


def resolve_direct_navigation_command(
    source: str, waypoints: Dict[str, Dict[str, Any]]
) -> Optional[str]:
    """Resolve an explicit, single-floor waypoint command without an LLM call.

    This path is deliberately narrow: cross-floor/elevator wording, negation,
    ambiguous destinations, and non-imperative text still go through the model
    and the existing grounding checks.
    """
    compact = re.sub(r"\s+", "", source or "").lower()
    if not compact or not DIRECT_NAV_RE.search(compact):
        return None
    if any(token in compact for token in DIRECT_NAV_NEGATIONS):
        return None
    if any(token in compact for token in ("电梯", "楼", "层")):
        return None

    matches = []
    for name, spec in waypoints.items():
        if bool(spec.get("internal", False)):
            continue
        tokens = [name, *spec.get("aliases", [])]
        if any(
            str(token).strip().lower() in compact
            for token in tokens
            if str(token).strip()
        ):
            matches.append(name)
    return matches[0] if len(matches) == 1 else None


