def yaw_to_quat(yaw: float) -> Tuple[float, float, float, float]:
    half = yaw * 0.5
    return (0.0, 0.0, math.sin(half), math.cos(half))


def extract_json(text: str) -> Dict[str, Any]:
    text = text.strip()
    try:
        data = json.loads(text)
    except json.JSONDecodeError:
        match = JSON_RE.search(text)
        if not match:
            raise ValueError(f"no JSON object in model output: {text!r}")
        data = json.loads(match.group(0))
    if not isinstance(data, dict):
        raise ValueError("model output must be a JSON object")
    return data


def normalize_model_call(parsed: Dict[str, Any]) -> Dict[str, Any]:
    """Accept the new tool schema and the earlier intent schema during migration."""
    if parsed.get("tool"):
        return {
            "tool": str(parsed["tool"]).strip(),
            "arguments": parsed.get("arguments") or {},
        }
    intent = str(parsed.get("intent") or "").strip().lower()
    mapping = {
        "navigate": ("navigate", {"waypoint": parsed.get("waypoint", "")}),
        "patrol": ("patrol_start", {"mode": parsed.get("mode", "loop")}),
        "patrol_stop": ("patrol_stop", {}),
        "elevator": ("elevator_enter", {"floor": parsed.get("floor", "")}),
        "cancel": ("cancel_all", {}),
    }
    if intent == "clarify":
        return {
            "tool": "clarify",
            "arguments": {"message": parsed.get("message", "")},
        }
    if intent not in mapping:
        raise ValueError(f"unsupported model response: {parsed}")
    tool, arguments = mapping[intent]
    return {"tool": tool, "arguments": arguments}


MOTION_TOOL_HINTS = {
    "patrol_start": ("巡航", "巡逻"),
    "patrol_resume": ("继续巡航", "恢复巡航", "继续巡逻", "恢复巡逻"),
    "mission_resume": ("继续任务", "恢复任务"),
