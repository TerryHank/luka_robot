 'patrol_start':['巡航','巡逻'], 'patrol_stop':['停止','结束','取消'], 'patrol_route_set':['路线','巡航','顺序'],
 'find_object':['找','查找'], 'object_bring':['带我','带路'], 'localization_auto':['重定位','重新定位'],
