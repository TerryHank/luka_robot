"""Read-only navigation readiness from live ROS data; never enables motion."""
import math,time,shutil
from pathlib import Path

def sensor_state(entry,now,limit=.5):
 if entry is None:return {'ready':False,'age_s':None,'reason':'尚未收到有效数据'}
 age=now-entry
 return {'ready':0<=age<limit,'age_s':round(age,3),'reason':'正常' if 0<=age<limit else '数据过期'}

class RuntimeHealth:
 def __init__(self,node):
  from sensor_msgs.msg import LaserScan
  from nav_msgs.msg import Odometry
  from rclpy.qos import qos_profile_sensor_data
  self.node=node;self.last={};self.resource_at=0;self.resources={}
  for topic in ('/scan','/scan_low_filtered'):
   node.create_subscription(LaserScan,topic,lambda m,t=topic:self.scan(t,m),qos_profile_sensor_data)
  node.create_subscription(Odometry,'/wheel/odom',self.odom,qos_profile_sensor_data)
 def scan(self,topic,msg):
  stamp=msg.header.stamp.sec+msg.header.stamp.nanosec/1e9
  age=self.node.get_clock().now().nanoseconds/1e9-stamp
  if -.1<age<.5 and any(math.isfinite(x) and msg.range_min<x<msg.range_max for x in msg.ranges):self.last[topic]=time.monotonic()
 def odom(self,msg):
  age=self.node.get_clock().now().nanoseconds/1e9-msg.header.stamp.sec-msg.header.stamp.nanosec/1e9
  if -.1<age<.5:self.last['odom']=time.monotonic()
 def snapshot(self):
  from rclpy.time import Time
  now=time.monotonic();n=self.node
  checks=[dict(name=name,**sensor_state(self.last.get(key),now)) for key,name in [('/scan','高位雷达'),('/scan_low_filtered','低位雷达'),('odom','轮式里程计')]]
  ready=False;reason='缺少 map 到 base_link 坐标变换'
  try:
   tf=n.object_pose_context.buffer.lookup_transform('map','base_link',Time())
   age=n.get_clock().now().nanoseconds/1e9-tf.header.stamp.sec-tf.header.stamp.nanosec/1e9
   ready=-.5<age<.6;reason='位置估计新鲜，仍需人工核对地图' if ready else '定位数据过期'
  except Exception:
   if not n.relocalization.pose_at:reason='尚未获得初始定位，请在地图上设置当前位置和朝向'
  checks.append(dict(name='地图定位',ready=ready,reason=reason))
  checks.append(dict(name='导航接口',ready=n.nx_nav.server_is_ready(),reason='可接收请求' if n.nx_nav.server_is_ready() else '导航接口未就绪'))
  if now-self.resource_at>5:
   self.resource_at=now
   try:
    mem={k:int(v.split()[0]) for k,v in (line.split(':',1) for line in Path('/proc/meminfo').read_text().splitlines())}
    self.resources={'available_memory_mb':mem['MemAvailable']//1024,'disk_free_gb':round(shutil.disk_usage('/home/sunrise').free/1024**3,1)}
   except (OSError,ValueError,KeyError):self.resources={}
  problems=[c['name']+'：'+c['reason'] for c in checks if not c['ready']]
  if n.relocalization.running:problems.append('正在重定位，请等待并核对结果')
  warnings=[]
  if self.resources.get('available_memory_mb',9999)<500:warnings.append('可用内存不足500MB')
  if self.resources.get('disk_free_gb',999)<5:warnings.append('磁盘剩余不足5GB，请整理录像')
  return {'checks':checks,'navigation_data_ready':not problems,'problems':problems,'warnings':warnings,'resources':self.resources,'message':'；'.join(problems) if problems else '导航所需数据已就绪；行驶前仍需核对地图位置和周围环境'}

