"""Short-lived map observation point for a visible, already selected person.

This is not a persistent person location. A measured stereo range anchors a
map point; a later visible bearing may support one short approach while stereo
range is unavailable. No identity, localization, or obstacle gate is relaxed.
"""
import math
import time


def angle(value):
    return math.atan2(math.sin(value), math.cos(value))


def planar_pose(context):
    if (not isinstance(context, dict) or context.get('localization_valid') is not True
            or context.get('map_scope_valid') is not True
            or context.get('map_pose_status') != 'tf_at_capture_time'):
        return None
    transform = context.get('map_from_base') or {}
    position, quaternion = transform.get('translation'), transform.get('quaternion_xyzw')
    if (not isinstance(position, list) or len(position) < 2 or
            not isinstance(quaternion, list) or len(quaternion) != 4):
        return None
    values = [*position[:2], *quaternion]
    if not all(isinstance(v, (int, float)) and math.isfinite(v) for v in values):
        return None
    qx, qy, qz, qw = quaternion
    yaw = math.atan2(2*(qw*qz+qx*qy), 1-2*(qy*qy+qz*qz))
    scope = (context.get('floor_id'), context.get('map_id'), context.get('map_version'))
    if not all(isinstance(v, str) and v for v in scope):
        return None
    return float(position[0]), float(position[1]), yaw, scope


def selected_person(people):
    target = people.get('target_session') or {}
    if not (target.get('active') and target.get('visible')):
        return None
    rows = [r for r in people.get('tracks') or [] if
            r.get('track_id') == target.get('track_id') and r.get('visible') is True and
            not r.get('association_ambiguous') and
            r.get('observation_strength') in ('strong', 'strong_detection',
                                              'stable_moderate_observation')]
    return rows[0] if len(rows) == 1 else None


class MapFollowEstimate:
    def __init__(self, camera_forward_m=.18, require_chest=False):
        self.camera_forward_m = float(camera_forward_m)
        self.require_chest = bool(require_chest)
        self.anchor = None
        self.pose = None
        self.status_reason = '尚无有效双目地图观测'

    def clear(self, reason='目标已改变'):
        self.anchor = None
        self.pose = None
        self.status_reason = reason

    def observe(self, people, context, now=None):
        now = time.monotonic() if now is None else float(now)
        pose = planar_pose(context)
        person = selected_person(people)
        target = people.get('target_session') or {}
        frame = people.get('frame_at')
        if (pose is None or person is None or not isinstance(frame, (int, float))
                or not math.isfinite(frame) or
                not isinstance(context.get('captured_at'), (int, float)) or
                abs(context['captured_at']-frame) > .05):
            self.pose = None
            self.status_reason = '定位或可见人体未通过核验'
            return
        identity = (target.get('profile_id'), target.get('track_id'))
        if self.anchor and (self.anchor['identity'] != identity or
                            self.anchor['scope'] != pose[3]):
            self.clear('跟随目标或地图已改变')
        self.pose = dict(x=pose[0], y=pose[1], yaw=pose[2], scope=pose[3],
                         frame=frame, received=now)
        distance = person.get('distance_m')
        bearing = person.get('bearing_rad')
        diagnostic = person.get('depth_diagnostic') or {}
        chest_distance = diagnostic.get('chest_distance_m')
        chest_confirmed = (diagnostic.get('chest_reason') == 'ok' and
                           isinstance(chest_distance, (int, float)) and
                           isinstance(distance, (int, float)) and
                           math.isfinite(chest_distance) and
                           math.isfinite(distance) and
                           abs(chest_distance-distance) <= .2)
        if (people.get('metric_depth_available') is not True or
                person.get('depth_valid') is not True or
                not isinstance(distance, (int, float)) or not .6 < distance < 4.
                or not isinstance(bearing, (int, float)) or not math.isfinite(bearing)
                or abs(bearing) > 1. or (self.require_chest and not chest_confirmed)):
            self.status_reason = '等待下一次双目距离；保留短时地图锚点'
            return
        yaw = pose[2]
        camera_x = pose[0] + self.camera_forward_m*math.cos(yaw)
        camera_y = pose[1] + self.camera_forward_m*math.sin(yaw)
        lateral = -distance*math.tan(bearing)
        x = camera_x + distance*math.cos(yaw) - lateral*math.sin(yaw)
        y = camera_y + distance*math.sin(yaw) + lateral*math.cos(yaw)
        velocity = (0., 0.)
        old = self.anchor
        if old and old['identity'] == identity and old['scope'] == pose[3]:
            dt = frame-old['frame']
            if .15 <= dt <= 1.5:
                dx, dy = x-old['x'], y-old['y']
                if math.hypot(dx, dy) <= 1.2*dt+.18:
                    velocity = (max(-1., min(1., dx/dt)), max(-1., min(1., dy/dt)))
        self.anchor = dict(x=x, y=y, velocity=velocity, frame=frame, received=now,
                           robot_x=pose[0], robot_y=pose[1], identity=identity,
                           scope=pose[3])
        self.status_reason = '已有新鲜双目地图观测'

    def hint(self, people, now=None):
        """A bounded observation waypoint; caller must still run motion gates."""
        now = time.monotonic() if now is None else float(now)
        anchor, pose = self.anchor, self.pose
        person = selected_person(people)
        target = people.get('target_session') or {}
        frame = people.get('frame_at')
        if (not anchor or not pose or not person or
                people.get('metric_depth_available') is not True or
                not isinstance(frame, (int, float))):
            return None
        if ((target.get('profile_id'), target.get('track_id')) != anchor['identity'] or
                pose['scope'] != anchor['scope'] or pose['frame'] != frame or
                not 0 <= now-pose['received'] <= .55 or
                not 0 <= now-anchor['received'] <= 1.2 or
                not 0 <= frame-anchor['frame'] <= 1.2 or
                math.hypot(pose['x']-anchor['robot_x'], pose['y']-anchor['robot_y']) > .25):
            return None
        bearing = person.get('bbox_bearing_rad')
        if not isinstance(bearing, (int, float)) or not math.isfinite(bearing):
            return None
        age = frame-anchor['frame']
        x = anchor['x'] + anchor['velocity'][0]*age
        y = anchor['y'] + anchor['velocity'][1]*age
        yaw = pose['yaw']
        camera_x = pose['x'] + self.camera_forward_m*math.cos(yaw)
        camera_y = pose['y'] + self.camera_forward_m*math.sin(yaw)
        dx, dy = x-camera_x, y-camera_y
        predicted_bearing = angle(yaw-math.atan2(dy, dx))
        bearing_error = abs(angle(bearing-predicted_bearing))
        forward_distance = dx*math.cos(yaw)+dy*math.sin(yaw)
        if bearing_error > .22 or not 1.55 < forward_distance < 3.5:
            return None
        direct = math.hypot(x-pose['x'], y-pose['y'])
        if direct <= 1.45:
            return None
        unit_x, unit_y = (x-pose['x'])/direct, (y-pose['y'])/direct
        # Observation waypoint faces the estimated person, but motion remains
        # limited to 0.25 m beyond the latest measured robot position.
        waypoint = (x-1.45*unit_x, y-1.45*unit_y)
        waypoint_dx, waypoint_dy = waypoint[0]-pose['x'], waypoint[1]-pose['y']
        waypoint_forward = waypoint_dx*math.cos(yaw)+waypoint_dy*math.sin(yaw)
        waypoint_heading = angle(math.atan2(waypoint_dy, waypoint_dx)-yaw)
        if waypoint_forward <= .08 or abs(waypoint_heading) > .55:
            return None
        self.status_reason = '双目暂缺，地图观察点短时有效'
        return dict(distance_m=forward_distance, person_map_x=x, person_map_y=y,
                    waypoint_x=waypoint[0], waypoint_y=waypoint[1],
                    waypoint_yaw=math.atan2(y-pose['y'], x-pose['x']),
                    waypoint_forward_m=waypoint_forward,
                    waypoint_heading_error_rad=waypoint_heading,
                    age_s=age, bearing_error_rad=bearing_error,
                    remaining_robot_travel_m=max(0., .25-math.hypot(
                        pose['x']-anchor['robot_x'], pose['y']-anchor['robot_y'])))

    def status(self):
        return dict(anchored=self.anchor is not None,
                    reason=self.status_reason,
                    map_id=self.anchor['scope'][1] if self.anchor else None)
