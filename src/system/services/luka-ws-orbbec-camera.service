[Unit]
Description=Luka Astra Pro Plus RGB-D camera (Orbbec SDK v1)
After=network.target

[Service]
Type=simple
User=sunrise
Group=sunrise
WorkingDirectory=/home/sunrise/luka_ws
ExecStart=/bin/bash /home/sunrise/luka_ws/system/scripts/start_orbbec_camera.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
