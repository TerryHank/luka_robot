# /etc/systemd/system/luka-ws-dashboard.service
[Unit]
Description=Luka S100 software-only dashboard
After=network-online.target

[Service]
Type=simple
User=sunrise
Group=sunrise
WorkingDirectory=/home/sunrise/luka_ws
ExecStart=/home/sunrise/luka_ws/src/system/bringup/start_s100_dashboard.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

# /etc/systemd/system/luka-ws-dashboard.service.d/audited-path.conf
[Service]
Environment=NX_FOLLOW_AUDITED_PATH=1

# /etc/systemd/system/luka-ws-dashboard.service.d/follow-detour.conf
[Service]
Environment=NX_FOLLOW_NAV_DETOUR=1

# /etc/systemd/system/luka-ws-dashboard.service.d/follow-nav2.conf
[Service]
Environment=NX_FOLLOW_NAV_MODE=1
Environment=NX_FOLLOW_NAV_DETOUR=1

# /etc/systemd/system/luka-ws-dashboard.service.d/safe-escape.conf
[Service]
Environment=NX_SAFE_ESCAPE=1

# /etc/systemd/system/luka-ws-dashboard.service.d/zz-follow-hybrid.conf
[Service]
Environment=NX_FOLLOW_NAV_MODE=0
Environment=NX_FOLLOW_HYBRID=1
Environment=NX_FOLLOW_NAV_DETOUR=1
Environment=NX_FOLLOW_AUDITED_PATH=1
