#!/usr/bin/env bash
set -u

# NetworkManager normally reconnects on its own. This handles a connection
# which remains marked connected while traffic to the local gateway is stuck.
profile='HUAWEI-1CR9ZZ'
device='wlan0'
state_file='/run/luka-ws-wifi-failures'
gateway='192.168.3.1'

state="$(nmcli -g GENERAL.STATE device show "$device" 2>/dev/null || true)"
if [[ "$state" == 100* ]] && ping -I "$device" -c 1 -W 2 "$gateway" >/dev/null 2>&1; then
  rm -f "$state_file"
  exit 0
fi

failures=0
if [[ -r "$state_file" ]]; then
  read -r failures < "$state_file" || failures=0
fi
[[ "$failures" =~ ^[0-9]+$ ]] || failures=0
failures=$((failures + 1))
printf '%s\n' "$failures" > "$state_file"

# Allow normal NetworkManager auto-reconnect to work before intervening.
if (( failures < 3 )); then
  exit 0
fi

logger -t luka-ws-wifi "Wi-Fi unhealthy for ${failures} checks; reconnecting ${profile}"
nmcli radio wifi on >/dev/null 2>&1 || true
if [[ "$state" == 100* ]]; then
  nmcli connection down "$profile" >/dev/null 2>&1 || true
fi
nmcli connection up "$profile" ifname "$device" >/dev/null 2>&1 || true

if ping -I "$device" -c 1 -W 2 "$gateway" >/dev/null 2>&1; then
  rm -f "$state_file"
  logger -t luka-ws-wifi 'Wi-Fi recovered'
else
  # Retry after three more checks, avoiding a tight reconnection loop.
  printf '0\n' > "$state_file"
  logger -t luka-ws-wifi 'Wi-Fi reconnection pending'
fi
